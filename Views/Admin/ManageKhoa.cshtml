@model List<StudentManagementSystem.Models.Khoa>
@{ ViewBag.Title = "Quản lý Khoa"; }

<div class="container mt-4">
    <h2 class="mb-4"><i class="fas fa-building text-success"></i> Quản Lý Khoa / Đơn Vị Đào Tạo</h2>

    <button type="button" class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#addKhoaModal">
        + Thêm Khoa Mới
    </button>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-bordered mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center">Mã Khoa</th>
                        <th>Tên Khoa</th>
                        <th>Thông Tin Liên Hệ</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold">@item.KhoaID</td>
                            <td class="fw-bold">@item.TenKhoa</td>
                            <td>@item.LienHe</td>
                            <td class="text-center">
                                <a href="@Url.Action("DeleteKhoa", "Admin", new { id = item.KhoaID })" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa khoa này không?');">
                                    <i class="fas fa-trash-alt"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm Khoa -->
<div class="modal fade" id="addKhoaModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="@Url.Action("CreateKhoa", "Admin")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">Thêm Khoa Mới</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên Khoa</label>
                        <input type="text" name="TenKhoa" class="form-control" required placeholder="VD: Khoa Công nghệ thông tin" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Thông tin liên hệ (Email/SĐT/Phòng ban)</label>
                        <input type="text" name="LienHe" class="form-control" placeholder="VD: p.daotao@cntt.edu.vn" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success">Lưu Khoa</button>
                </div>
            </form>
        </div>
    </div>
</div>