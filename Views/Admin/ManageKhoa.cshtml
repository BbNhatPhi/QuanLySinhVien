@model List<StudentManagementSystem.Models.Khoa>
@{ ViewBag.Title = "Quản lý Khoa"; }

<div class="container-fluid px-4 mt-4 mb-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-building text-success"></i> Quản Lý Khoa / Đơn Vị Đào Tạo</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Admin")" class="text-decoration-none">Trang Chủ</a></li>
                    <li class="breadcrumb-item active">Quản Lý Khoa</li>
                </ol>
            </nav>
        </div>
        <button type="button" class="btn btn-success fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addKhoaModal">
            <i class="fas fa-plus me-1"></i> Thêm Khoa Mới
        </button>
    </div>

    <!-- Summary Card -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <i class="fas fa-building fa-2x opacity-75"></i>
                    <div>
                        <div class="fs-4 fw-bold">@Model.Count</div>
                        <div class="small opacity-75">Tổng số khoa</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card shadow border-0">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="fw-semibold text-secondary"><i class="fas fa-list me-1"></i> Danh sách các khoa đào tạo</span>
            <div style="max-width: 300px; width: 100%;">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm khoa..." data-search-table="tblKhoa" />
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="tblKhoa" class="table table-hover table-bordered align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-center" style="width:80px;">Mã Khoa</th>
                            <th>Tên Khoa / Đơn Vị</th>
                            <th>Thông Tin Liên Hệ</th>
                            <th class="text-center" style="width:100px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || Model.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="fas fa-building fa-2x d-block mb-2 opacity-25"></i>
                                    Chưa có dữ liệu khoa trong hệ thống.
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">
                                    <span class="badge bg-success rounded-pill px-3">@item.KhoaID</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center" style="width:36px;height:36px;flex-shrink:0;">
                                            <i class="fas fa-building text-success small"></i>
                                        </div>
                                        <span class="fw-bold">@item.TenKhoa</span>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.LienHe))
                                    {
                                        <span><i class="fas fa-envelope text-muted me-1"></i>@item.LienHe</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Chưa cập nhật</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <!-- FIX LỖI BẢO MẬT: dùng POST + AntiForgeryToken thay cho link GET -->
                                    <form action="@Url.Action("DeleteKhoa", "Admin")" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa khoa này không?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.KhoaID" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa khoa">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white border-top text-muted small py-2 px-3">
            Tổng cộng <strong>@Model.Count</strong> khoa / đơn vị đào tạo.
        </div>
    </div>
</div>

<!-- Modal Thêm Khoa -->
<div class="modal fade" id="addKhoaModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form action="@Url.Action("CreateKhoa", "Admin")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold"><i class="fas fa-plus-circle me-2"></i>Thêm Khoa Mới</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên Khoa</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-building text-muted"></i></span>
                            <input type="text" name="TenKhoa" class="form-control" required placeholder="VD: Khoa Công nghệ thông tin" />
                        </div>
                    </div>
                    <div class="mb-1">
                        <label class="form-label fw-semibold">Thông tin liên hệ <span class="text-muted fw-normal">(Email / SĐT / Phòng ban)</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-envelope text-muted"></i></span>
                            <input type="text" name="LienHe" class="form-control" placeholder="VD: p.daotao@cntt.edu.vn" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i>Hủy</button>
                    <button type="submit" class="btn btn-success btn-sm fw-bold"><i class="fas fa-save me-1"></i>Lưu Khoa</button>
                </div>
            </form>
        </div>
    </div>
</div>