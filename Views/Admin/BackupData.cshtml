@{ ViewBag.Title = "Sao Lưu Dữ Liệu"; }

<div class="container-fluid px-4 mt-4 mb-5">

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="mb-1"><i class="fas fa-database text-primary"></i> Sao Lưu Hệ Thống</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index","Admin")" class="text-decoration-none">Trang Chủ</a></li>
                <li class="breadcrumb-item active">Sao Lưu Dữ Liệu</li>
            </ol>
        </nav>
    </div>

    <div class="row g-4">

        <!-- Main Backup Card -->
        <div class="col-lg-7">
            <div class="card shadow border-0 h-100">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold text-primary"><i class="fas fa-cloud-download-alt me-2"></i>Tạo Bản Sao Lưu (Backup)</h5>
                </div>
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center py-5 px-4">
                    <div class="mb-4">
                        <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center mx-auto mb-3" style="width:90px;height:90px;">
                            <i class="fas fa-server text-primary" style="font-size:2.5rem;"></i>
                        </div>
                        <h5 class="fw-bold mb-2">Sao lưu toàn bộ cơ sở dữ liệu</h5>
                        <p class="text-muted mb-0" style="max-width:420px;">
                            Việc sao lưu sẽ tạo ra một bản copy toàn bộ dữ liệu hiện tại của hệ thống
                            (Sinh viên, Điểm số, Lịch học, Tài khoản...) và lưu vào ổ cứng máy chủ.
                            Khuyến nghị thực hiện định kỳ mỗi tuần.
                        </p>
                    </div>

                    <form action="@Url.Action("ExecuteBackup", "Admin")" method="post" onsubmit="return showLoading();">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm px-5" id="btnBackup">
                            <i class="fas fa-cloud-download-alt me-2"></i>Tiến Hành Sao Lưu Ngay
                        </button>
                    </form>

                    <div id="loadingDiv" class="mt-4 text-primary fw-semibold" style="display:none;">
                        <div class="d-flex align-items-center gap-2 justify-content-center">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <span>Đang nén dữ liệu, vui lòng đợi trong giây lát...</span>
                        </div>
                        <div class="progress mt-3" style="height: 6px; width: 320px; max-width: 100%;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" style="width:100%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Info / Tips Card -->
        <div class="col-lg-5">
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold text-warning"><i class="fas fa-exclamation-triangle me-2"></i>Lưu ý quan trọng</h6>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex gap-2 py-3">
                            <i class="fas fa-clock text-primary mt-1 flex-shrink-0"></i>
                            <span class="small">Quá trình sao lưu có thể mất <strong>vài phút</strong> tùy theo dung lượng dữ liệu.</span>
                        </li>
                        <li class="list-group-item d-flex gap-2 py-3">
                            <i class="fas fa-ban text-danger mt-1 flex-shrink-0"></i>
                            <span class="small">Không tắt trình duyệt hoặc đóng trang trong quá trình sao lưu.</span>
                        </li>
                        <li class="list-group-item d-flex gap-2 py-3">
                            <i class="fas fa-folder-open text-success mt-1 flex-shrink-0"></i>
                            <span class="small">File backup sẽ được lưu vào thư mục cấu hình trên máy chủ.</span>
                        </li>
                        <li class="list-group-item d-flex gap-2 py-3">
                            <i class="fas fa-calendar-alt text-info mt-1 flex-shrink-0"></i>
                            <span class="small">Khuyến nghị sao lưu <strong>định kỳ mỗi tuần</strong> hoặc trước mỗi đợt cập nhật hệ thống.</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- What gets backed up -->
            <div class="card shadow border-0">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold text-success"><i class="fas fa-check-circle me-2"></i>Dữ liệu được sao lưu</h6>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-6">
                            <div class="d-flex align-items-center gap-2 small">
                                <i class="fas fa-user-graduate text-primary"></i> Hồ sơ sinh viên
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex align-items-center gap-2 small">
                                <i class="fas fa-star text-warning"></i> Dữ liệu điểm số
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex align-items-center gap-2 small">
                                <i class="fas fa-calendar-check text-success"></i> Lịch học & TKB
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex align-items-center gap-2 small">
                                <i class="fas fa-users-cog text-danger"></i> Tài khoản người dùng
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex align-items-center gap-2 small">
                                <i class="fas fa-book text-info"></i> Ngành & Môn học
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="d-flex align-items-center gap-2 small">
                                <i class="fas fa-chalkboard text-secondary"></i> Phòng học
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    function showLoading() {
        document.getElementById('btnBackup').disabled = true;
        document.getElementById('loadingDiv').style.display = 'block';
        return true;
    }
</script>