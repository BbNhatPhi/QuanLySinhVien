@model Dictionary<string, int>
@{
    ViewBag.Title = "Dashboard Quản Trị";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4"><i class="fas fa-chart-line text-primary"></i> Tổng quan Hệ thống</h2>

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="card text-white bg-primary shadow">
            <div class="card-body">
                <h5 class="card-title">Tổng Sinh viên</h5>
                <h2 class="display-5">@Model["Students"]</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card text-white bg-success shadow">
            <div class="card-body">
                <h5 class="card-title">Giảng viên</h5>
                <h2 class="display-5">@Model["Teachers"]</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card text-white bg-warning shadow">
            <div class="card-body">
                <h5 class="card-title">Khoa Đào tạo</h5>
                <h2 class="display-5">@Model["Khoa"]</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-4">
        <div class="card text-white bg-info shadow">
            <div class="card-body">
                <h5 class="card-title">Tài khoản Active</h5>
                <h2 class="display-5">@Model["ActiveUsers"]</h2>
            </div>
        </div>
    </div>
</div>