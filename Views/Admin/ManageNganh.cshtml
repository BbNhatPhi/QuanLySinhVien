@model IEnumerable<StudentManagementSystem.Models.Nganh>
@{
    ViewBag.Title = "Quản lý Ngành Học";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 mt-4 mb-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-graduation-cap text-primary"></i> Quản Lý Ngành Học</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Admin")" class="text-decoration-none">Trang Chủ</a></li>
                    <li class="breadcrumb-item active">Quản Lý Ngành Học</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addNganhModal">
            <i class="fas fa-plus me-1"></i> Thêm Ngành Mới
        </button>
    </div>

    <!-- Summary -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <i class="fas fa-graduation-cap fa-2x opacity-75"></i>
                    <div>
                        <div class="fs-4 fw-bold">@Model.Count()</div>
                        <div class="small opacity-75">Tổng số ngành</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card shadow border-0">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="fw-semibold text-secondary"><i class="fas fa-list me-1"></i> Danh sách ngành đào tạo</span>
            <div style="max-width: 300px; width: 100%;">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm ngành..." data-search-table="tblNganh" />
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="tblNganh" class="table table-hover table-bordered align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-center" style="width:80px;">Mã Ngành</th>
                            <th>Tên Ngành Đào Tạo</th>
                            <th style="width:200px;">Thuộc Khoa</th>
                            <th class="text-center" style="width:100px;">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="fas fa-graduation-cap fa-2x d-block mb-2 opacity-25"></i>
                                    Chưa có dữ liệu ngành học.
                                </td>
                            </tr>
                        }
                        @foreach (var nganh in Model)
                        {
                            <tr>
                                <td class="text-center">
                                    <span class="badge bg-primary rounded-pill px-3">@nganh.NganhID</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width:34px;height:34px;flex-shrink:0;">
                                            <i class="fas fa-book text-primary small"></i>
                                        </div>
                                        <span class="fw-bold text-primary">@nganh.TenNganh</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary rounded-pill px-3">@nganh.TenKhoa</span>
                                </td>
                                <td class="text-center">
                                    <!-- NÚT SỬA ĐÃ ĐƯỢC GẮN DATA ATTRIBUTES -->
                                    <button type="button" class="btn btn-sm btn-outline-warning edit-nganh-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editNganhModal"
                                            data-id="@nganh.NganhID"
                                            data-ten="@nganh.TenNganh"
                                            data-khoaid="@nganh.KhoaID"
                                            title="Chỉnh sửa ngành">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white border-top text-muted small py-2 px-3">
            Tổng cộng <strong>@Model.Count()</strong> ngành đào tạo.
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- Modal Form Thêm Ngành -->
<!-- ========================================== -->
<div class="modal fade" id="addNganhModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form action="@Url.Action("CreateNganh", "Admin")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold"><i class="fas fa-plus-circle me-2"></i>Thêm Ngành Đào Tạo</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên Ngành:</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-book text-muted"></i></span>
                            <input type="text" name="tenNganh" class="form-control" required placeholder="VD: Kỹ thuật phần mềm..." />
                        </div>
                    </div>
                    <div class="mb-1">
                        <label class="form-label fw-semibold">Trực thuộc Khoa:</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-building text-muted"></i></span>
                            <select name="khoaId" class="form-select" required>
                                <option value="">-- Chọn Khoa --</option>
                                @if (ViewBag.ListKhoa != null)
                                {
                                    foreach (var khoa in ViewBag.ListKhoa as IEnumerable<StudentManagementSystem.Models.Khoa>)
                                    {
                                        <option value="@khoa.KhoaID">@khoa.TenKhoa</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i>Hủy</button>
                    <button type="submit" class="btn btn-primary btn-sm fw-bold"><i class="fas fa-save me-1"></i>Xác nhận tạo</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- Modal Form Sửa Ngành -->
<!-- ========================================== -->
<div class="modal fade" id="editNganhModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <!-- Form trỏ về Action EditNganh -->
            <form action="@Url.Action("EditNganh", "Admin")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold"><i class="fas fa-edit me-2"></i>Cập Nhật Ngành Học</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Input ẩn chứa ID ngành -->
                    <input type="hidden" name="nganhId" id="editNganhId" value="" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên Ngành:</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-book text-muted"></i></span>
                            <input type="text" name="tenNganh" id="editTenNganh" class="form-control border-warning" required />
                        </div>
                    </div>
                    <div class="mb-1">
                        <label class="form-label fw-semibold">Trực thuộc Khoa:</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-building text-muted"></i></span>
                            <select name="khoaId" id="editKhoaId" class="form-select border-warning" required>
                                <option value="">-- Chọn Khoa --</option>
                                @if (ViewBag.ListKhoa != null)
                                {
                                    foreach (var khoa in ViewBag.ListKhoa as IEnumerable<StudentManagementSystem.Models.Khoa>)
                                    {
                                        <option value="@khoa.KhoaID">@khoa.TenKhoa</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal"><i class="fas fa-times me-1"></i>Hủy bỏ</button>
                    <button type="submit" class="btn btn-warning btn-sm fw-bold"><i class="fas fa-save me-1"></i>Lưu Thay Đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SCRIPT GẮN DỮ LIỆU TỰ ĐỘNG (vanilla JS, không cần jQuery) -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.edit-nganh-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.getElementById('editNganhId').value = this.dataset.id;
                document.getElementById('editTenNganh').value = this.dataset.ten;
                var sel = document.getElementById('editKhoaId');
                sel.value = this.dataset.khoaid;
            });
        });
    });
</script>