@model IEnumerable<StudentManagementSystem.Models.Nganh>
@{
    ViewBag.Title = "Quản lý Ngành Học";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-graduation-cap text-primary"></i> Quản lý Ngành Học</h2>
    <button class="btn btn-primary fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addNganhModal">
        <i class="fas fa-plus"></i> Thêm Ngành Mới
    </button>
</div>

<div class="card shadow border-0">
    <div class="card-body">
        <table class="table table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th class="text-center" style="width: 15%">Mã Ngành</th>
                    <th>Tên Ngành Đào Tạo</th>
                    <th>Thuộc Khoa</th>
                    <th class="text-center" style="width: 15%">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center py-4 text-muted">Chưa có dữ liệu ngành học.</td></tr>
                }
                @foreach (var nganh in Model)
                {
                    <tr>
                        <td class="text-center fw-bold">@nganh.NganhID</td>
                        <td><b class="text-primary">@nganh.TenNganh</b></td>
                        <td><span class="badge bg-secondary">@nganh.TenKhoa</span></td>
                        <td class="text-center">
                            <!-- NÚT SỬA ĐÃ ĐƯỢC GẮN DATA ATTRIBUTES -->
                            <button type="button" class="btn btn-sm btn-outline-warning fw-bold edit-nganh-btn"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editNganhModal"
                                    data-id="@nganh.NganhID"
                                    data-ten="@nganh.TenNganh"
                                    data-khoaid="@nganh.KhoaID">
                                <i class="fas fa-edit"></i> Sửa
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ========================================== -->
<!-- Modal Form Thêm Ngành -->
<!-- ========================================== -->
<div class="modal fade" id="addNganhModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="@Url.Action("CreateNganh", "Admin")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold"><i class="fas fa-plus-circle"></i> Thêm Ngành Đào Tạo</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên Ngành:</label>
                        <input type="text" name="tenNganh" class="form-control" required placeholder="VD: Kỹ thuật phần mềm..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Trực thuộc Khoa:</label>
                        <select name="khoaId" class="form-select" required>
                            <option value="">-- Chọn Khoa --</option>
                            @if (ViewBag.ListKhoa != null)
                            {
                                foreach (var khoa in ViewBag.ListKhoa as IEnumerable<StudentManagementSystem.Models.Khoa>)
                                {
                                    <option value="@khoa.KhoaID">@khoa.TenKhoa</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary fw-bold"><i class="fas fa-save"></i> Xác nhận tạo</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- Modal Form Sửa Ngành (THÊM MỚI) -->
<!-- ========================================== -->
<div class="modal fade" id="editNganhModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <!-- Form trỏ về Action EditNganh -->
            <form action="@Url.Action("EditNganh", "Admin")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold"><i class="fas fa-edit"></i> Cập Nhật Ngành Học</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Input ẩn chứa ID ngành -->
                    <input type="hidden" name="nganhId" id="editNganhId" value="" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên Ngành:</label>
                        <input type="text" name="tenNganh" id="editTenNganh" class="form-control border-warning" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Trực thuộc Khoa:</label>
                        <select name="khoaId" id="editKhoaId" class="form-select border-warning" required>
                            <option value="">-- Chọn Khoa --</option>
                            @if (ViewBag.ListKhoa != null)
                            {
                                foreach (var khoa in ViewBag.ListKhoa as IEnumerable<StudentManagementSystem.Models.Khoa>)
                                {
                                    <option value="@khoa.KhoaID">@khoa.TenKhoa</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-warning fw-bold"><i class="fas fa-save"></i> Lưu Thay Đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SCRIPT GẮN DỮ LIỆU TỰ ĐỘNG -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        // Khi click vào nút sửa ngành
        $('.edit-nganh-btn').on('click', function () {
            // Lấy dữ liệu từ nút
            var id = $(this).data('id');
            var ten = $(this).data('ten');
            var khoaid = $(this).data('khoaid');

            // Gắn vào Modal
            $('#editNganhId').val(id);
            $('#editTenNganh').val(ten);
            $('#editKhoaId').val(khoaid);
        });
    });
</script>