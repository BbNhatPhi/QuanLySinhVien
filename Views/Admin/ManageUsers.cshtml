@model List<StudentManagementSystem.Models.User>
@{ ViewBag.Title = "Quản lý Tài Khoản"; }

<div class="container mt-4 mb-5">
    <h2 class="mb-4"><i class="fas fa-users-cog text-primary"></i> Quản Lý Tài Khoản Hệ Thống</h2>

    <!-- Nút kích hoạt Modal Thêm Tài Khoản -->
    <button type="button" class="btn btn-success fw-bold shadow-sm mb-3" data-bs-toggle="modal" data-bs-target="#addUserModal">
        <i class="fas fa-plus"></i> Thêm Tài Khoản Mới
    </button>

    <div class="mb-3" style="max-width: 380px;">
        <div class="input-group">
            <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
            <input type="text" class="form-control" placeholder="Tìm kiếm tài khoản..." data-search-table="tblUsers" />
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table id="tblUsers" class="table table-hover table-bordered mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center">ID</th>
                        <th>Tên Đăng Nhập</th>
                        <th>Họ & Tên</th>
                        <th>Nhóm Quyền</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold">@item.UserID</td>
                            <td class="fw-bold text-primary">@item.Username</td>
                            <td>@item.HoTen</td>
                            <td>
                                <span class="badge @(item.RoleID == 1 ? "bg-danger" : (item.RoleID == 2 ? "bg-warning text-dark" : "bg-success"))">
                                    @item.RoleName
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                    @(item.IsActive ? "Hoạt động" : "Bị khóa")
                                </span>
                            </td>
                            <td class="text-center">
                                <!-- Nút Đổi Quyền -->
                                <button type="button" class="btn btn-sm btn-outline-info mb-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#changeRoleModal_@item.UserID" title="Thay đổi phân quyền">
                                    <i class="fas fa-user-shield"></i>
                                </button>

                                <!-- Nút Khóa / Mở khóa -->
                                <form action="@Url.Action("ToggleStatus", "Admin")" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@item.UserID" />
                                    <input type="hidden" name="currentStatus" value="@(item.IsActive ? "true" : "false")" />
                                    <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success") mb-1 shadow-sm" title="@(item.IsActive ? "Khóa tài khoản này" : "Mở khóa tài khoản")">
                                        <i class="fas @(item.IsActive ? "fa-lock" : "fa-unlock")"></i>
                                    </button>
                                </form>

                                <!-- Nút Xóa -->
                                <a href="@Url.Action("DeleteUser", "Admin", new { id = item.UserID })" class="btn btn-sm btn-outline-danger mb-1 shadow-sm" onclick="return confirm('Bạn có chắc chắn muốn xóa tài khoản này khỏi hệ thống không?');" title="Xóa tài khoản">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </td>
                        </tr>

                        <!-- Modal Đổi Quyền cho từng User -->
                        <div class="modal fade" id="changeRoleModal_@item.UserID" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form action="@Url.Action("ChangeUserRole", "Admin")" method="post">
                                        @Html.AntiForgeryToken()
                                        <div class="modal-header bg-info text-dark">
                                            <h5 class="modal-title fw-bold"><i class="fas fa-user-shield"></i> Phân Quyền Tài Khoản</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body text-start p-4">
                                            <input type="hidden" name="userId" value="@item.UserID" />
                                            <p>Tài khoản: <strong>@item.Username</strong> (@item.HoTen)</p>
                                            <p>Quyền hiện tại: <strong class="text-danger">@item.RoleName</strong></p>
                                            <hr />
                                            <div class="mb-3">
                                                <label class="form-label fw-bold">Nâng cấp / Giáng chức thành:</label>
                                                <!-- ĐÃ ĐỔI THÀNH newRoleId ĐỂ HẾT BÁO LỖI NULL -->
                                                <select name="newRoleId" class="form-select border-info" required>
                                                    <option value="1" @(item.RoleID == 1 ? "selected" : "")>Admin (Quản trị viên)</option>
                                                    <option value="2" @(item.RoleID == 2 ? "selected" : "")>Giảng Viên</option>
                                                    <option value="3" @(item.RoleID == 3 ? "selected" : "")>Nhân Viên Đào Tạo</option>
                                                    <option value="4" @(item.RoleID == 4 ? "selected" : "")>Sinh Viên</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                            <button type="submit" class="btn btn-info fw-bold text-dark"><i class="fas fa-save"></i> Lưu Phân Quyền</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- Modal Thêm Tài Khoản Mới -->
<!-- ========================================== -->
<div class="modal fade" id="addUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="@Url.Action("CreateUser", "Admin")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold"><i class="fas fa-user-plus"></i> Tạo Tài Khoản Mới</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên đăng nhập (Username)</label>
                        <input type="text" name="username" class="form-control border-dark" required placeholder="Nhập tên đăng nhập (VD: GV005)" />
                    </div>

                    <!-- BỔ SUNG Ô NHẬP HỌ TÊN VÀO ĐÂY -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ & Tên hiển thị</label>
                        <input type="text" name="hoTen" class="form-control border-dark" required placeholder="Nhập họ và tên (VD: Nguyễn Văn A)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu</label>
                        <input type="password" name="password" class="form-control border-dark" required placeholder="Nhập mật khẩu" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Phân Quyền (Role)</label>
                        <select name="roleId" class="form-select border-dark" required>
                            <option value="">-- Chọn nhóm quyền --</option>
                            <option value="1">Admin (Quản trị viên)</option>
                            <option value="2">Giảng Viên</option>
                            <option value="3">Nhân Viên Đào Tạo</option>
                            <option value="4">Sinh Viên</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success fw-bold"><i class="fas fa-check-circle"></i> Tạo Tài Khoản</button>
                </div>
            </form>
        </div>
    </div>
</div>