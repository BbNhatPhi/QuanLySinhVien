@model List<StudentManagementSystem.Models.GiangVien>
@{
    ViewBag.Title = "Quản lý Giảng Viên";
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="fas fa-chalkboard-teacher"></i> Quản Lý Phân Công Giảng Viên</h2>

    <button type="button" class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#addGVModal">
        + Thêm Giảng Viên Mới
    </button>

    @if (TempData["SuccessMsg"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMsg"]</div>
    }
    @if (TempData["ErrorMsg"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMsg"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-bordered table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center">Mã GV</th>
                        <th>Họ Tên</th>
                        <th>Đơn Vị / Khoa</th>
                        <th>Môn Phụ Trách</th>
                        <th>Liên Hệ</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold text-primary">@item.MaGV</td>
                                <td class="fw-bold">@item.HoTen</td>
                                <td>@item.TenKhoa</td>
                                <td>
                                    <span class="badge bg-warning text-dark px-2 py-1">@item.TenMon</span>
                                </td>
                                <td>
                                    <small><i class="fas fa-envelope"></i> @item.Email</small><br />
                                    <small><i class="fas fa-phone"></i> @item.SoDienThoai</small>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary" title="Sửa"><i class="fas fa-edit"></i></button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">Chưa có dữ liệu Giảng viên.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Form Thêm GV -->
<div class="modal fade" id="addGVModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="@Url.Action("AddGiangVien", "Staff")" method="post">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">Thêm Hồ Sơ Giảng Viên</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-4">
                            <label class="form-label fw-bold">Mã GV</label>
                            <input type="text" name="MaGV" class="form-control" placeholder="VD: GV002" required />
                        </div>
                        <div class="col-8">
                            <label class="form-label fw-bold">Họ và Tên</label>
                            <input type="text" name="HoTen" class="form-control" placeholder="Nhập tên giảng viên" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-primary">Phân công Môn dạy (Chuyên môn)</label>
                        <select name="MaMon" class="form-select border-primary" required>
                            <option value="">-- Chọn Môn Học --</option>
                            @if (ViewBag.ListMonHoc != null)
                            {
                                foreach (var mon in ViewBag.ListMonHoc)
                                {
                                    <option value="@mon.MaMon">@mon.TenMon (@mon.MaMon)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Trực thuộc Khoa</label>
                        <select name="KhoaID" class="form-select" required>
                            <option value="">-- Chọn Khoa --</option>
                            @if (ViewBag.ListKhoa != null)
                            {
                                foreach (var khoa in ViewBag.ListKhoa)
                                {
                                    <option value="@khoa.KhoaID">@khoa.TenKhoa</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold">Điện thoại</label>
                            <input type="text" name="SoDienThoai" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">Email</label>
                            <input type="email" name="Email" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success">Lưu Thông Tin</button>
                </div>
            </form>
        </div>
    </div>
</div>