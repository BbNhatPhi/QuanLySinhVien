@model List<StudentManagementSystem.Models.ThoiKhoaBieu>
@{
    ViewBag.Title = "Quản lý Thời Khóa Biểu";
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="fas fa-calendar-alt"></i> Lập Thời Khóa Biểu</h2>

    <button type="button" class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#addTKBModal">
        + Xếp Lịch Mới
    </button>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-bordered table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center">Mã Lớp HP</th>
                        <th>Môn Học</th>
                        <th>Giảng Viên</th>
                        <th class="text-center">Thứ / Ngày</th>
                        <th class="text-center">Ca Học</th>
                        <th class="text-center">Phòng Học</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold text-primary">@item.MaLopHP</td>
                                <td>@item.TenMon</td>
                                <td>@item.TenGV</td>
                                <td class="text-center fw-bold">@item.TenNgayHoc</td>
                                <td class="text-center">
                                    <span class="badge bg-info text-dark">Ca @item.TenCaHoc</span>
                                </td>
                                <td class="text-center fw-bold text-danger">@item.PhongHoc</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">Chưa có dữ liệu Thời khóa biểu.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Form Lập TKB -->
<div class="modal fade" id="addTKBModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="@Url.Action("AddTKB", "Staff")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">Xếp Lịch Học Mới</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Chọn Lớp Học Phần</label>
                        <select name="MaLopHP" class="form-select" required>
                            <option value="">-- Chọn Lớp Học Phần --</option>
                            @if (ViewBag.ListLopHocPhan != null)
                            {
                                foreach (var lhp in ViewBag.ListLopHocPhan)
                                {
                                    <option value="@lhp.MaLopHP">@lhp.MaLopHP - @lhp.TenMon (@lhp.TenGV)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold">Ngày Học</label>
                            <select name="NgayHoc" class="form-select" required>
                                <option value="2">Thứ 2</option>
                                <option value="3">Thứ 3</option>
                                <option value="4">Thứ 4</option>
                                <option value="5">Thứ 5</option>
                                <option value="6">Thứ 6</option>
                                <option value="7">Thứ 7</option>
                                <option value="8">Chủ nhật</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">Ca Học</label>
                            <select name="CaHoc" class="form-select" required>
                                <option value="1">Ca Sáng</option>
                                <option value="2">Ca Chiều</option>
                                <option value="3">Ca Tối</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Phòng Học</label>
                        <input type="text" name="PhongHoc" class="form-control" placeholder="VD: A1-202" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success">Lưu Thời Khóa Biểu</button>
                </div>
            </form>
        </div>
    </div>
</div>