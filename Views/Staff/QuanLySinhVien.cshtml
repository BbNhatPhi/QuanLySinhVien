@model IEnumerable<StudentManagementSystem.Models.SinhVien>
@{
    ViewBag.Title = "Quản Lý Sinh Viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-user-graduate text-primary"></i> Quản Lý Hồ Sơ Sinh Viên</h2>
    <!-- Nút mở Modal Thêm Sinh Viên -->
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addStudentModal">
        <i class="fas fa-plus-circle"></i> Thêm Sinh Viên Mới
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow border-0">
    <div class="card-body">
        <table class="table table-hover table-bordered align-middle text-center">
            <thead class="table-dark">
                <tr>
                    <th>Mã SV</th>
                    <th class="text-start">Họ Tên</th>
                    <th>Ngày Sinh</th>
                    <th>Giới Tính</th>
                    <th>Email</th>
                    <!-- Đã sửa tiêu đề từ Ngành sang Khoa -->
                    <th>Khoa</th>
                    <th>Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sv in Model)
                {
                    <tr>
                        <td class="fw-bold">@sv.MaSV</td>
                        <td class="text-start">@sv.HoTen</td>
                        <td>@(sv.NgaySinh.HasValue ? sv.NgaySinh.Value.ToString("dd/MM/yyyy") : "")</td>
                        <td>@sv.GioiTinh</td>
                        <td>@sv.Email</td>
                        <!-- Đã sửa sv.MaNganh thành sv.TenKhoa để in ra chữ -->
                        <td class="fw-bold text-primary">@sv.TenKhoa</td>
                        <td>
                            <a href="@Url.Action("XoaSinhVien", "Staff", new { maSV = sv.MaSV })"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('Bạn có chắc chắn muốn xóa sinh viên này không?');">
                                <i class="fas fa-trash-alt"></i> Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Thêm Sinh Viên Giao diện nổi -->
<div class="modal fade" id="addStudentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Thêm Sinh Viên Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="@Url.Action("ThemSinhVien", "Staff")" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mã Sinh Viên</label>
                        <input type="text" class="form-control" name="MaSV" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ Tên</label>
                        <input type="text" class="form-control" name="HoTen" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Ngày Sinh</label>
                            <input type="date" class="form-control" name="NgaySinh" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Giới Tính</label>
                            <select class="form-select" name="GioiTinh">
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email</label>
                        <input type="email" class="form-control" name="Email" />
                    </div>

                    <!-- ĐÃ SỬA HOÀN TOÀN TỪ NGÀNH SANG KHOA -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-primary">Trực thuộc Khoa</label>
                        <select class="form-select border-primary" name="KhoaID" required>
                            <option value="">-- Chọn Khoa --</option>
                            @if (ViewBag.ListKhoa != null)
                            {
                                foreach (var khoa in ViewBag.ListKhoa)
                                {
                                    <option value="@khoa.KhoaID">@khoa.TenKhoa</option>
                                }
                            }
                        </select>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu Dữ Liệu</button>
                </div>
            </form>
        </div>
    </div>
</div>