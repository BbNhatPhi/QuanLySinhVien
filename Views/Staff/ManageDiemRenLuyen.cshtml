@model List<StudentManagementSystem.Models.DiemRenLuyen>
@{
    ViewBag.Title = "Quản lý Điểm rèn luyện";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><i class="fas fa-medal text-primary"></i> Quản Lý Điểm Rèn Luyện</h2>
        <button type="button" class="btn btn-success fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#addDiemModal">
            <i class="fas fa-plus"></i> Nhập Điểm Mới
        </button>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover table-bordered mb-0 align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th width="15%">Mã SV</th>
                        <th width="20%">Học Kỳ</th>
                        <th width="15%">Điểm Số</th>
                        <th>Xếp Loại</th>
                        <th width="15%">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold text-primary">@item.MaSV</td>
                                <td class="text-center fw-bold">@item.HocKy</td>
                                <td class="text-center fw-bold text-danger fs-5">@item.Diem</td>
                                <td class="text-center">
                                    @{
                                        string bgClass = "bg-secondary";
                                        if (item.XepLoai == "Xuất sắc") { bgClass = "bg-success"; }
                                        else if (item.XepLoai == "Tốt") { bgClass = "bg-primary"; }
                                        else if (item.XepLoai == "Khá") { bgClass = "bg-info text-dark"; }
                                        else if (item.XepLoai == "Trung bình") { bgClass = "bg-warning text-dark"; }
                                        else if (item.XepLoai == "Yếu") { bgClass = "bg-danger"; }
                                    }
                                    <span class="badge @bgClass p-2">@item.XepLoai</span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <!-- Nút Sửa -->
                                        <button type="button" class="btn btn-sm btn-outline-warning fw-bold edit-diem-btn shadow-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editDiemModal"
                                                data-id="@item.ID"
                                                data-masv="@item.MaSV"
                                                data-hocky="@item.HocKy"
                                                data-diem="@item.Diem">
                                            <i class="fas fa-edit"></i>
                                        </button>

                                        <!-- Nút Xóa -->
                                        <form action="@Url.Action("DeleteDiemRenLuyen", "Staff")" method="post" onsubmit="return confirm('Xóa điểm rèn luyện của sinh viên @item.MaSV trong @item.HocKy?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.ID" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger fw-bold shadow-sm">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">Chưa có dữ liệu điểm rèn luyện!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 1. MODAL THÊM ĐIỂM -->
<!-- ========================================== -->
<div class="modal fade" id="addDiemModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="@Url.Action("AddDiemRenLuyen", "Staff")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title fw-bold"><i class="fas fa-plus-circle"></i> Nhập Điểm Rèn Luyện</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mã Sinh Viên</label>
                        <input type="text" name="maSV" class="form-control border-success" placeholder="VD: 2400000099" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Học Kỳ</label>
                        <select name="hocKy" class="form-select border-success" required>
                            <option value="HK1 (2025-2026)">HK1 (2025-2026)</option>
                            <option value="HK2 (2025-2026)">HK2 (2025-2026)</option>
                            <option value="HK3 (2025-2026)">HK3 (2025-2026)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Điểm Số (0 - 100)</label>
                        <input type="number" name="diem" class="form-control border-success" min="0" max="100" required />
                        <small class="text-muted">Hệ thống sẽ tự động tính xếp loại (Xuất sắc, Tốt, Khá...)</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success fw-bold"><i class="fas fa-save"></i> Lưu Điểm</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 2. MODAL SỬA ĐIỂM -->
<!-- ========================================== -->
<div class="modal fade" id="editDiemModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="@Url.Action("EditDiemRenLuyen", "Staff")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold"><i class="fas fa-edit"></i> Cập Nhật Điểm Rèn Luyện</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="id" id="editID" />

                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold">Mã Sinh Viên</label>
                            <input type="text" id="editMaSV" class="form-control bg-light" readonly />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">Học Kỳ</label>
                            <input type="text" id="editHocKy" class="form-control bg-light" readonly />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Sửa Điểm Số</label>
                        <input type="number" name="diem" id="editDiem" class="form-control border-warning" min="0" max="100" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-warning fw-bold"><i class="fas fa-save"></i> Lưu Thay Đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- SCRIPT ĐIỀN DỮ LIỆU -->
<!-- ========================================== -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $('.edit-diem-btn').on('click', function () {
            $('#editID').val($(this).data('id'));
            $('#editMaSV').val($(this).data('masv'));
            $('#editHocKy').val($(this).data('hocky'));
            $('#editDiem').val($(this).data('diem'));
        });
    });
</script>