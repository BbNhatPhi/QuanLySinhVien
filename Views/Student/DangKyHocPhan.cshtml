@model List<StudentManagementSystem.Models.LopHocPhan>
@{
    ViewBag.Title = "Đăng Ký Học Phần";

    // Lấy danh sách các mã lớp đã đăng ký từ ViewBag (do Controller truyền sang)
    List<string> listDaDK = ViewBag.ListMaLopDaDK as List<string> ?? new List<string>();
}

<div class="container mt-4">
    <h2 class="mb-4"><i class="fas fa-mouse-pointer text-primary"></i> Đăng Ký Học Phần</h2>

    @if (TempData["SuccessMsg"] != null)
    {
        <div class="alert alert-success fw-bold"><i class="fas fa-check-circle"></i> @TempData["SuccessMsg"]</div>
    }
    @if (TempData["ErrorMsg"] != null)
    {
        <div class="alert alert-danger fw-bold"><i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMsg"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white fw-bold">
            Danh sách Lớp học phần đang mở
        </div>
        <div class="card-body p-0">
            <table class="table table-hover table-bordered mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="text-center">Mã Lớp HP</th>
                        <th>Môn Học</th>
                        <th>Giảng Viên</th>
                        <th class="text-center">Học Kỳ / Năm</th>
                        <th class="text-center">Sỉ số</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            // Kiểm tra xem môn này đã đăng ký chưa và đã đầy chưa
                            bool isRegistered = listDaDK.Contains(item.MaLopHP);
                            bool isFull = Convert.ToInt32(item.TrangThai) >= item.SoLuongMax;

                            <tr>
                                <td class="text-center fw-bold text-primary">@item.MaLopHP</td>
                                <td class="fw-bold">@item.TenMon</td>
                                <td>@item.TenGV</td>
                                <td class="text-center">HK @item.HocKy<br /><small class="text-muted">@item.NamHoc</small></td>
                                <td class="text-center">
                                    <!-- Hiển thị Sỉ số hiện tại / Sỉ số Max -->
                                    <span class="badge @(isFull ? "bg-danger" : "bg-success") fs-6">
                                        @item.TrangThai / @item.SoLuongMax
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (isRegistered)
                                    {
                                        <!-- TRƯỜNG HỢP 1: ĐÃ ĐĂNG KÝ -->
                                        <button type="button" class="btn btn-secondary btn-sm fw-bold" disabled>
                                            <i class="fas fa-check"></i> Đã đăng ký
                                        </button>
                                    }
                                    else if (isFull)
                                    {
                                        <!-- TRƯỜNG HỢP 2: LỚP ĐÃ ĐẦY -->
                                        <button type="button" class="btn btn-danger btn-sm fw-bold" disabled>
                                            <i class="fas fa-ban"></i> Đã đầy
                                        </button>
                                    }
                                    else
                                    {
                                        <!-- TRƯỜNG HỢP 3: CHƯA ĐĂNG KÝ VÀ CÒN CHỖ -->
                                        <form action="@Url.Action("XuLyDangKy", "Student")" method="post" class="m-0">
                                            <input type="hidden" name="maLopHP" value="@item.MaLopHP" />
                                            <button type="submit" class="btn btn-primary btn-sm fw-bold">
                                                <i class="fas fa-plus"></i> Đăng Ký
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Hiện tại không có lớp học phần nào mở đăng ký!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>