@model List<StudentManagementSystem.Models.YeuCauHanhChinh>
@{
    ViewBag.Title = "Dịch Vụ Hành Chính Một Cửa";
}

<div class="container mt-4 mb-5">
    <h2 class="mb-4"><i class="fas fa-university text-primary"></i> Dịch Vụ Hành Chính</h2>

    <div class="row">
        <!-- Form Gửi Yêu Cầu -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white fw-bold">
                    <i class="fas fa-paper-plane"></i> Gửi Yêu Cầu Mới
                </div>
                <div class="card-body">
                    <form action="@Url.Action("GuiYeuCau", "Student")" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-bold">Loại Dịch Vụ</label>
                            <select name="loaiDichVu" class="form-select border-primary" required>
                                <option value="">-- Chọn loại giấy tờ/yêu cầu --</option>
                                <option value="Cấp bản sao Bảng điểm">Cấp bản sao Bảng điểm</option>
                                <option value="Giấy xác nhận Sinh viên">Giấy xác nhận Sinh viên (Vay vốn, Tạm hoãn NVQS)</option>
                                <option value="Đơn xin cấp lại Thẻ SV">Đơn xin cấp lại Thẻ SV</option>
                                <option value="Đơn xin bảo lưu học tập">Đơn xin bảo lưu học tập</option>
                                <option value="Khác">Yêu cầu khác...</option>
                            </select>
                        </div>

                        <!-- Đã bổ sung ô Số Lượng -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Số lượng bản sao</label>
                            <input type="number" name="soLuong" class="form-control" value="1" min="1" max="10" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mô tả chi tiết / Lý do</label>
                            <!-- Đã sửa name="lyDo" thành name="moTa" -->
                            <textarea name="moTa" class="form-control" rows="3" required placeholder="Ghi rõ mục đích sử dụng, hoặc lý do bảo lưu..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-bold shadow-sm">
                            <i class="fas fa-paper-plane"></i> Gửi Yêu Cầu
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Bảng Theo Dõi Trạng Thái -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white fw-bold">
                    <i class="fas fa-tasks"></i> Tình Trạng Xử Lý Hồ Sơ
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover table-bordered mb-0 align-middle">
                        <thead class="table-light text-center">
                            <tr>
                                <th width="10%">Mã YC</th>
                                <th width="28%">Loại Dịch Vụ</th>
                                <th width="10%">Số Lượng</th>
                                <th width="22%">Ngày Gửi</th>
                                <th width="30%">Trạng Thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <!-- Đã sửa item.MaYeuCau thành item.MaYC -->
                                        <td class="text-center fw-bold text-secondary">#@item.MaYC</td>
                                        <td class="fw-bold text-primary">@item.LoaiDichVu</td>
                                        <td class="text-center fw-bold">@item.SoLuong</td>
                                        <td class="text-center">@item.NgayGui.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-center">
                                            <!-- Đã đồng bộ màu sắc và Text trạng thái với Nhân Viên -->
                                            @if (item.TrangThai == "Đang chờ xử lý")
                                            {
                                                <span class="badge bg-warning text-dark px-3 py-2"><i class="fas fa-hourglass-half"></i> Chờ xử lý</span>
                                            }
                                            else if (item.TrangThai == "Đang xử lý")
                                            {
                                                <span class="badge bg-info text-dark px-3 py-2"><i class="fas fa-cog fa-spin"></i> Đang xử lý</span>
                                            }
                                            else if (item.TrangThai == "Hoàn thành")
                                            {
                                                <span class="badge bg-success px-3 py-2"><i class="fas fa-check"></i> Hoàn thành</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger px-3 py-2"><i class="fas fa-times"></i> @item.TrangThai</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Bạn chưa gửi yêu cầu hành chính nào!</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>