@model IEnumerable<StudentManagementSystem.Models.KetQuaHocTap>
@{
    ViewBag.Title = "Kết Quả Học Tập";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var dsDiem = Model != null ? Model.ToList() : new List<StudentManagementSystem.Models.KetQuaHocTap>();

    // Tính toán số liệu học tập tích lũy theo chuẩn tín chỉ đại học
    int tongTinChiDangKy = dsDiem.Sum(x => x.SoTinChi);
    int tongTinChiDat = dsDiem.Where(x => x.DiemTong >= 4.0).Sum(x => x.SoTinChi);
    int soMonNo = dsDiem.Count(x => x.DiemTong < 4.0 && (x.DiemCC > 0 || x.DiemGK > 0 || x.DiemCK > 0));

    double tongDiemHe10NhanTC = dsDiem.Sum(x => x.DiemTong * x.SoTinChi);
    double dtbHe10 = tongTinChiDangKy > 0 ? Math.Round(tongDiemHe10NhanTC / tongTinChiDangKy, 2) : 0;

    double tongDiemHe4NhanTC = dsDiem.Sum(x => {
        double he4 = x.DiemTong >= 8.5 ? 4.0 : (x.DiemTong >= 7.0 ? 3.0 : (x.DiemTong >= 5.5 ? 2.0 : (x.DiemTong >= 4.0 ? 1.0 : 0.0)));
        return he4 * x.SoTinChi;
    });
    double gpaHe4 = tongTinChiDangKy > 0 ? Math.Round(tongDiemHe4NhanTC / tongTinChiDangKy, 2) : 0;

    string xepLoai = "Chưa xếp loại";
    string badgeXepLoai = "bg-secondary";
    if (tongTinChiDangKy > 0)
    {
        if (gpaHe4 >= 3.6) { xepLoai = "Xuất sắc"; badgeXepLoai = "bg-danger"; }
        else if (gpaHe4 >= 3.2) { xepLoai = "Giỏi"; badgeXepLoai = "bg-success"; }
        else if (gpaHe4 >= 2.5) { xepLoai = "Khá"; badgeXepLoai = "bg-primary"; }
        else if (gpaHe4 >= 2.0) { xepLoai = "Trung bình"; badgeXepLoai = "bg-warning text-dark"; }
        else { xepLoai = "Yếu"; badgeXepLoai = "bg-dark"; }
    }
}

@functions {
    public string LayDiemChu(double diem)
    {
        if (diem >= 8.5) return "A";
        if (diem >= 7.0) return "B";
        if (diem >= 5.5) return "C";
        if (diem >= 4.0) return "D";
        return "F";
    }
    public double LayDiemHe4(double diem)
    {
        if (diem >= 8.5) return 4.0;
        if (diem >= 7.0) return 3.0;
        if (diem >= 5.5) return 2.0;
        if (diem >= 4.0) return 1.0;
        return 0.0;
    }
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="mb-1 fw-bold text-dark"><i class="fas fa-graduation-cap text-primary me-2"></i>Kết Quả Học Tập Tín Chỉ</h2>
            <p class="text-muted mb-0 small">Bảng theo dõi điểm số, điểm chữ và điểm trung bình tích lũy theo quy chế đào tạo đại học.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("InBangDiemCaNhan", "Student")" target="_blank" class="btn btn-outline-primary btn-sm fw-bold">
                <i class="fas fa-print me-1"></i> In Bảng Điểm Tích Lũy
            </a>
        </div>
    </div>

    <!-- KHỐI KPI TỔNG KẾT HỌC LỰC CHUẨN ĐẠI HỌC -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Điểm TB tích lũy (Hệ 10)</div>
                        <div class="fs-3 fw-bold text-primary mt-1">@dtbHe10 <small class="fs-6 text-muted">/ 10</small></div>
                    </div>
                    <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                        <i class="fas fa-award fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Điểm tích lũy (GPA Hệ 4)</div>
                        <div class="fs-3 fw-bold text-success mt-1">@gpaHe4 <small class="fs-6 text-muted">/ 4.0</small></div>
                    </div>
                    <div class="p-3 bg-success-subtle text-success rounded-circle">
                        <i class="fas fa-chart-line fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 border-start border-4 border-info">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Tín chỉ đã tích lũy</div>
                        <div class="fs-3 fw-bold text-info mt-1">@tongTinChiDat <small class="fs-6 text-muted">/ @tongTinChiDangKy TC</small></div>
                    </div>
                    <div class="p-3 bg-info-subtle text-info rounded-circle">
                        <i class="fas fa-book-bookmark fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-sm-6">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100 border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Xếp loại học lực</div>
                        <div class="mt-2">
                            <span class="badge @badgeXepLoai fs-6 px-3 py-2">@xepLoai</span>
                        </div>
                    </div>
                    <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                        <i class="fas fa-medal fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG ĐIỂM CHI TIẾT CÁC HỌC PHẦN -->
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="fw-bold"><i class="fas fa-table-list me-2"></i>Bảng Điểm Chi Tiết Các Học Phần</span>
            <div class="small text-light">
                <span class="badge bg-success me-1">Đạt (&ge; 4.0)</span>
                <span class="badge bg-danger">Chưa đạt (&lt; 4.0)</span>
            </div>
        </div>
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover table-bordered align-middle text-center mb-0">
                <thead class="table-light align-middle">
                    <tr>
                        <th rowspan="2" style="width: 50px;">STT</th>
                        <th rowspan="2" class="text-start">Tên Học Phần</th>
                        <th rowspan="2" style="width: 70px;">Số TC</th>
                        <th rowspan="2" style="width: 110px;">Học Kỳ</th>
                        <th colspan="3" class="bg-light">Điểm Thành Phần</th>
                        <th colspan="3" class="bg-primary text-white">Điểm Tổng Kết</th>
                        <th rowspan="2" style="width: 110px;">Kết Quả</th>
                    </tr>
                    <tr>
                        <th style="width: 85px;" title="Chuyên cần 10%">CC (10%)</th>
                        <th style="width: 85px;" title="Giữa kỳ 30%">GK (30%)</th>
                        <th style="width: 85px;" title="Cuối kỳ 60%">CK (60%)</th>
                        <th style="width: 85px;" class="bg-primary-subtle text-primary fw-bold">Hệ 10</th>
                        <th style="width: 80px;" class="bg-primary-subtle text-primary fw-bold">Hệ 4</th>
                        <th style="width: 80px;" class="bg-primary-subtle text-primary fw-bold">Điểm Chữ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!dsDiem.Any())
                    {
                        <tr>
                            <td colspan="11" class="text-muted py-5">
                                <i class="fas fa-folder-open fs-1 text-secondary opacity-50 mb-2 d-block"></i>
                                Hiện chưa có dữ liệu điểm học phần trong hệ thống.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int stt = 1;
                        foreach (var item in dsDiem)
                        {
                            bool isPass = item.DiemTong >= 4.0;
                            double diemHe4 = LayDiemHe4(item.DiemTong);
                            string diemChu = LayDiemChu(item.DiemTong);

                            <tr class="@(!isPass ? "table-danger-subtle" : "")">
                                <td class="fw-bold text-muted">@(stt++)</td>
                                <td class="text-start fw-bold text-dark">@item.TenMon</td>
                                <td class="fw-bold">@item.SoTinChi</td>
                                <td class="small">HK @item.HocKy<br /><span class="text-muted">@item.NamHoc</span></td>
                                <td>@item.DiemCC.ToString("0.0")</td>
                                <td>@item.DiemGK.ToString("0.0")</td>
                                <td>@item.DiemCK.ToString("0.0")</td>
                                <td>
                                    <span class="fw-bold @(isPass ? "text-success" : "text-danger") fs-6">
                                        @item.DiemTong.ToString("0.0")
                                    </span>
                                </td>
                                <td class="fw-bold">@diemHe4.ToString("0.0")</td>
                                <td>
                                    <span class="badge @(diemChu == "A" ? "bg-success" : (diemChu == "B" ? "bg-primary" : (diemChu == "C" ? "bg-info text-dark" : (diemChu == "D" ? "bg-warning text-dark" : "bg-danger")))) px-2 py-1">
                                        @diemChu
                                    </span>
                                </td>
                                <td>
                                    @if (isPass)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                            <i class="fas fa-check-circle me-1"></i>Đạt
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">
                                            <i class="fas fa-times-circle me-1"></i>Học lại
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>