@model IEnumerable<StudentManagementSystem.Models.KetQuaHocTap>
@{
    ViewBag.Title = "Kết Quả Học Tập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4"><i class="fas fa-chart-bar text-primary"></i> Bảng Điểm Cá Nhân</h2>

<div class="card shadow border-0">
    <div class="card-body">
        <table class="table table-striped table-bordered align-middle text-center">
            <thead class="table-dark">
                <tr>
                    <th rowspan="2" class="align-middle text-start">Môn Học</th>
                    <th rowspan="2" class="align-middle">Số TC</th>
                    <th rowspan="2" class="align-middle">Học Kỳ</th>
                    <th rowspan="2" class="align-middle">Năm Học</th>
                    <th colspan="4">Cột Điểm</th>
                </tr>
                <tr>
                    <th>Chuyên Cần (10%)</th>
                    <th>Giữa Kỳ (30%)</th>
                    <th>Cuối Kỳ (60%)</th>
                    <th class="bg-primary text-white">Tổng Kết</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-muted py-4">Chưa có dữ liệu điểm số.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-start fw-bold">@item.TenMon</td>
                        <td>@item.SoTinChi</td>
                        <td>HK @item.HocKy</td>
                        <td>@item.NamHoc</td>
                        <td>@item.DiemCC</td>
                        <td>@item.DiemGK</td>
                        <td>@item.DiemCK</td>
                        <td>
                            @if (item.DiemTong >= 4.0)
                            {
                                <span class="badge bg-success fs-6">@item.DiemTong</span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-6">@item.DiemTong</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>