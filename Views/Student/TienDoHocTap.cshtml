@model StudentManagementSystem.Models.TienDoHocTap
@{
    ViewBag.Title = "Tiến độ học tập";
    var chuongTrinhKhung = ViewBag.ChuongTrinhKhung as List<StudentManagementSystem.Models.ChuongTrinhKhungItem>;
    var thongTin = ViewBag.ThongTin as StudentManagementSystem.Models.SinhVien;
    
    double phanTramHoanThanh = 0;
    if (Model.TongTinChiYeuCau > 0)
    {
        phanTramHoanThanh = Math.Round((double)Model.TinChiTichLuy / Model.TongTinChiYeuCau * 100, 1);
    }
    string progressColor = phanTramHoanThanh >= 80 ? "bg-success" : (phanTramHoanThanh >= 50 ? "bg-primary" : "bg-warning");
}

<style>
    body { background-color: #f8f9fa; }
    .glass-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        border: none;
        overflow: hidden;
    }
    .header-banner {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        color: white;
        padding: 30px;
        border-radius: 12px;
        position: relative;
    }
    .circular-chart {
        display: block;
        margin: 0 auto;
        max-width: 80%;
        max-height: 250px;
    }
    .circle-bg { fill: none; stroke: #eee; stroke-width: 3.8; }
    .circle { 
        fill: none; stroke-width: 3.8; stroke-linecap: round;
        animation: progress 1s ease-out forwards;
    }
    @@keyframes progress { 0% { stroke-dasharray: 0 100; } }
    .percentage { fill: #333; font-family: sans-serif; font-size: 0.5em; text-anchor: middle; font-weight: bold;}
    
    .timeline { position: relative; margin: 20px 0; padding-left: 30px; list-style: none; }
    .timeline::before {
        content: ''; position: absolute; left: 11px; top: 0; bottom: 0; width: 2px; background: #e9ecef;
    }
    .timeline-item { position: relative; margin-bottom: 25px; }
    .timeline-icon {
        position: absolute; left: -30px; top: 0; width: 24px; height: 24px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center; font-size: 10px; color: white;
    }
    .bg-dat { background-color: #198754; }
    .bg-rot { background-color: #dc3545; }
    .bg-dang-hoc { background-color: #0dcaf0; }
</style>

<div class="row mb-4">
    <div class="col-12">
        <div class="header-banner shadow-sm d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold mb-1"><i class="fas fa-route me-2"></i>Chương trình đào tạo & Tiến độ</h2>
                <p class="mb-0 text-white-50">Sinh viên: <strong>@(thongTin?.HoTen ?? "N/A")</strong> | Ngành: <strong>@(thongTin?.TenNganh ?? "N/A")</strong></p>
            </div>
            <div class="text-end d-none d-md-block">
                <div class="fs-6 text-white-50">Tổng số tín chỉ yêu cầu</div>
                <div class="fs-1 fw-bold">@Model.TongTinChiYeuCau TC</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Biểu đồ tổng quan -->
    <div class="col-lg-4">
        <div class="glass-card h-100 p-4 text-center">
            <h5 class="fw-bold text-dark mb-4">Tỷ lệ hoàn thành</h5>
            
            <svg viewBox="0 0 36 36" class="circular-chart text-success mb-3">
                <path class="circle-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                <path class="circle" stroke="#198754" stroke-dasharray="@phanTramHoanThanh, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                <text x="18" y="20.35" class="percentage">@phanTramHoanThanh%</text>
            </svg>
            
            <div class="row text-center mt-4">
                <div class="col-6 border-end">
                    <div class="text-muted small text-uppercase fw-bold">Tích lũy</div>
                    <div class="fs-4 fw-bold text-success">@Model.TinChiTichLuy <small class="fs-6 text-muted">TC</small></div>
                </div>
                <div class="col-6">
                    <div class="text-muted small text-uppercase fw-bold">Chưa đạt/Nợ</div>
                    <div class="fs-4 fw-bold text-danger">@Model.SoMonNo <small class="fs-6 text-muted">Môn</small></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Thông số Điểm số -->
    <div class="col-lg-8">
        <div class="row g-3 h-100">
            <div class="col-sm-6">
                <div class="glass-card h-100 p-4 border-start border-4 border-primary">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="text-muted fw-bold mb-0 text-uppercase">Điểm trung bình (Hệ 4)</h6>
                        <i class="fas fa-star text-primary fs-4 opacity-50"></i>
                    </div>
                    <h2 class="display-5 fw-bold text-dark mb-1">@Model.GPA_He4.ToString("0.00")</h2>
                    @{
                        string xepLoaiGPA = Model.GPA_He4 >= 3.6 ? "Xuất sắc" : Model.GPA_He4 >= 3.2 ? "Giỏi" : Model.GPA_He4 >= 2.5 ? "Khá" : Model.GPA_He4 >= 2.0 ? "Trung bình" : "Yếu";
                        string xlColor = Model.GPA_He4 >= 3.2 ? "text-success" : Model.GPA_He4 >= 2.5 ? "text-primary" : "text-warning";
                    }
                    <div class="fw-bold @xlColor"><i class="fas fa-award me-1"></i> Xếp loại: @xepLoaiGPA</div>
                </div>
            </div>
            
            <div class="col-sm-6">
                <div class="glass-card h-100 p-4 border-start border-4 border-info">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="text-muted fw-bold mb-0 text-uppercase">Điểm trung bình (Hệ 10)</h6>
                        <i class="fas fa-chart-bar text-info fs-4 opacity-50"></i>
                    </div>
                    <h2 class="display-5 fw-bold text-dark mb-1">@Model.GPA_He10.ToString("0.00")</h2>
                    <div class="text-muted"><i class="fas fa-info-circle me-1"></i> Điểm tổng kết toàn khóa</div>
                </div>
            </div>

            <div class="col-12">
                <div class="glass-card p-4 d-flex align-items-center justify-content-between bg-light">
                    <div>
                        <h5 class="fw-bold text-dark mb-1"><i class="fas fa-check-circle text-success me-2"></i>Điều kiện Xét tốt nghiệp</h5>
                        <p class="text-muted mb-0 small">Phòng Đào Tạo yêu cầu Tín chỉ >= @Model.TongTinChiYeuCau và GPA >= 2.0</p>
                    </div>
                    <div>
                        @if (Model.TinChiTichLuy >= Model.TongTinChiYeuCau && Model.GPA_He4 >= 2.0 && Model.SoMonNo == 0)
                        {
                            <span class="badge bg-success fs-6 py-2 px-3"><i class="fas fa-medal me-1"></i>ĐỦ ĐIỀU KIỆN</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark fs-6 py-2 px-3"><i class="fas fa-hourglass-half me-1"></i>CHƯA ĐỦ ĐIỀU KIỆN</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lịch sử học tập -->
<div class="glass-card p-4">
    <h5 class="fw-bold text-dark mb-4"><i class="fas fa-history text-primary me-2"></i>Chương trình khung & Kế hoạch học tập chuẩn</h5>
    
    @if (chuongTrinhKhung != null && chuongTrinhKhung.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th style="width: 50px;">STT</th>
                        <th>Mã Môn</th>
                        <th>Tên Môn Học</th>
                        <th class="text-center">Tín chỉ</th>
                        <th class="text-center">Học Kỳ Yêu Cầu</th>
                        <th class="text-center">Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int stt = 1; }
                    @foreach (var ctk in chuongTrinhKhung)
                    {
                        <tr>
                            <td class="text-muted fw-bold">@stt</td>
                            <td><span class="badge bg-light text-dark border">@ctk.MaMon</span></td>
                            <td class="fw-bold text-dark">@ctk.TenMon</td>
                            <td class="text-center fw-bold">@ctk.SoTinChi</td>
                            <td class="text-center fw-bold text-primary">Học kỳ @ctk.HocKyTieuChuan</td>
                            <td class="text-center">
                                @if (ctk.TrangThai == "Qua môn") {
                                    <span class="badge bg-success-subtle text-success border border-success"><i class="fas fa-check me-1"></i>Đã tích lũy</span>
                                } else if (ctk.TrangThai == "Học lại") {
                                    <span class="badge bg-danger-subtle text-danger border border-danger"><i class="fas fa-times me-1"></i>Học lại</span>
                                } else if (ctk.TrangThai == "Đang học") {
                                    <span class="badge bg-info-subtle text-info border border-info"><i class="fas fa-sync fa-spin me-1"></i>Đang học</span>
                                } else {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary"><i class="fas fa-lock me-1"></i>Chưa học</span>
                                }
                            </td>
                        </tr>
                        stt++;
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-box-open fa-3x text-muted opacity-25 mb-3"></i>
            <p class="text-muted">Chưa có dữ liệu học tập nào được ghi nhận.</p>
        </div>
    }
</div>