@{ ViewBag.Title = "Thanh Toán Học Phí"; }

<div class="container-fluid px-4 mt-4 mb-5">

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <div>
            <h2 class="mb-0 fw-bold text-dark">
                <i class="fas fa-credit-card text-primary me-2"></i>Cổng Thanh Toán Học Phí Trực Tuyến
            </h2>
            <nav aria-label="breadcrumb" class="mt-1">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Student")" class="text-decoration-none">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("XemHocPhi","Student")" class="text-decoration-none">Học Phí</a></li>
                    <li class="breadcrumb-item active">Thanh Toán</li>
                </ol>
            </nav>
        </div>
        <a href="@Url.Action("XemHocPhi", "Student")" class="btn btn-outline-secondary fw-bold">
            <i class="fas fa-arrow-left me-1"></i>Quay lại
        </a>
    </div>

    <div class="row justify-content-center g-4">

        <!-- Left: Order Summary -->
        <div class="col-md-4">
            <div class="card shadow border-0 h-100">
                <div class="card-header bg-primary text-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-receipt me-2"></i>Chi Tiết Thanh Toán</h6>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-6 text-muted small">Học phần:</dt>
                        <dd class="col-6 fw-bold small">@ViewBag.TenMon</dd>

                        <dt class="col-6 text-muted small">Mã lớp HP:</dt>
                        <dd class="col-6 fw-bold small text-primary">@ViewBag.MaLopHP</dd>

                        <dt class="col-6 text-muted small">Nội dung CK:</dt>
                        <dd class="col-6 fw-bold small">NTTU @ViewBag.MaLopHP</dd>
                    </dl>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark">Tổng cộng:</span>
                        <span class="fs-5 fw-bold text-danger">
                            @string.Format("{0:N0}", ViewBag.SoTien) <small>VNĐ</small>
                        </span>
                    </div>
                </div>
                <div class="card-footer bg-light text-muted small">
                    <i class="fas fa-shield-alt text-success me-1"></i>
                    Giao dịch được bảo mật bằng SSL 256-bit
                </div>
            </div>

            <!-- Security badges -->
            <div class="card border-0 shadow-sm mt-3">
                <div class="card-body p-3 text-center">
                    <p class="text-muted small mb-2 fw-semibold">Phương thức thanh toán được hỗ trợ</p>
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <span class="badge bg-danger px-2 py-1 fs-6">MoMo</span>
                        <span class="badge bg-primary px-2 py-1 fs-6">VISA</span>
                        <span class="badge bg-warning text-dark px-2 py-1 fs-6">MasterCard</span>
                        <span class="badge bg-success px-2 py-1 fs-6">ATM</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Payment Form -->
        <div class="col-md-7">
            <div class="card shadow border-0">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold text-dark"><i class="fas fa-lock text-success me-2"></i>Chọn Phương Thức Thanh Toán</h6>
                </div>
                <div class="card-body p-4">
                    <form action="@Url.Action("XacNhanThanhToan", "Student")" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maLopHP" value="@ViewBag.MaLopHP" />
                        <input type="hidden" name="soTien" value="@ViewBag.SoTien" />

                        <!-- Payment tabs -->
                        <ul class="nav nav-tabs mb-4" id="paymentTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active fw-bold" id="momo-tab"
                                        data-bs-toggle="tab" data-bs-target="#momo"
                                        type="button" role="tab">
                                    <span class="text-danger">● </span>Ví MoMo
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold" id="bank-tab"
                                        data-bs-toggle="tab" data-bs-target="#bank"
                                        type="button" role="tab">
                                    <span class="text-primary">● </span>Thẻ Ngân Hàng
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content" id="paymentTabsContent">

                            <!-- MoMo Panel -->
                            <div class="tab-pane fade show active" id="momo" role="tabpanel">
                                <div class="text-center py-3">
                                    <h6 class="text-danger mb-3 fw-bold">
                                        <i class="fas fa-qrcode me-2"></i>Quét mã QR bằng ứng dụng MoMo
                                    </h6>
                                    <div class="p-4 border-2 border border-danger rounded d-inline-block bg-light mb-3">
                                        <i class="fas fa-qrcode" style="font-size: 8rem; color: #a50064;"></i>
                                    </div>
                                    <div class="alert alert-light border text-center mt-2 py-2">
                                        <small class="text-muted">Nội dung chuyển khoản:</small><br />
                                        <strong class="text-dark">NTTU @ViewBag.MaLopHP</strong>
                                    </div>
                                    <p class="text-muted small">Mã QR có hiệu lực trong <strong class="text-danger">15 phút</strong></p>
                                </div>
                            </div>

                            <!-- Bank Card Panel -->
                            <div class="tab-pane fade" id="bank" role="tabpanel">
                                <div class="py-2">
                                    <h6 class="text-primary mb-4 fw-bold">
                                        <i class="fas fa-credit-card me-2"></i>Thông Tin Thẻ ATM / Visa / Mastercard
                                    </h6>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold small">Số thẻ</label>
                                        <input type="text" class="form-control" placeholder="XXXX XXXX XXXX XXXX" maxlength="19" />
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-6">
                                            <label class="form-label fw-bold small">Ngày hết hạn</label>
                                            <input type="text" class="form-control" placeholder="MM/YY" maxlength="5" />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label fw-bold small">Mã CVV</label>
                                            <input type="password" class="form-control" placeholder="***" maxlength="3" />
                                        </div>
                                    </div>
                                    <div class="mt-3">
                                        <label class="form-label fw-bold small">Tên in trên thẻ <span class="text-muted fw-normal">(Không dấu)</span></label>
                                        <input type="text" class="form-control text-uppercase" placeholder="NGUYEN VAN A" />
                                    </div>
                                </div>
                            </div>

                        </div>

                        <hr class="mt-4" />

                        <div class="alert alert-warning small py-2 mb-3">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            Vui lòng kiểm tra lại thông tin trước khi xác nhận thanh toán. Giao dịch không thể hoàn tác.
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100 fw-bold shadow-sm">
                            <i class="fas fa-check-circle me-2"></i>
                            Xác Nhận Đã Thanh Toán — @string.Format("{0:N0}", ViewBag.SoTien) VNĐ
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>