@{ ViewBag.Title = "Thanh Toán Học Phí"; }

<style>
    body { background-color: #f8f9fa; }
    .payment-container {
        max-width: 800px;
        margin: 40px auto;
    }
    .payment-card {
        border-radius: 20px;
        border: none;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        overflow: hidden;
    }
    .payment-header {
        background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
        padding: 40px 30px;
        color: white;
        text-align: center;
        position: relative;
    }
    .payment-header::after {
        content: '';
        position: absolute;
        bottom: -20px;
        left: 50%;
        transform: translateX(-50%);
        border-width: 20px 20px 0;
        border-style: solid;
        border-color: #2c5364 transparent transparent transparent;
        display: block;
        width: 0;
    }
    .invoice-details {
        background: white;
        padding: 40px 30px;
        border-radius: 0 0 20px 20px;
    }
    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 15px 0;
        border-bottom: 1px dashed #dee2e6;
    }
    .detail-row:last-child {
        border-bottom: none;
    }
    .amount-total {
        font-size: 2.5rem;
        font-weight: 800;
        color: #dc3545;
        margin: 20px 0;
    }
    .btn-pay {
        background: linear-gradient(to right, #0062E6, #33AEFF);
        border: none;
        padding: 15px 40px;
        font-size: 1.2rem;
        border-radius: 50px;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-pay:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(0, 98, 230, 0.3);
    }
</style>

<div class="container-fluid payment-container">
    <div class="mb-3">
        <a href="@Url.Action("XemHocPhi", "Student")" class="text-decoration-none text-muted fw-bold">
            <i class="fas fa-arrow-left me-2"></i>Quay lại danh sách nợ
        </a>
    </div>

    <div class="card payment-card">
        <div class="payment-header">
            <div class="mb-3">
                <i class="fas fa-file-invoice-dollar fs-1 text-info"></i>
            </div>
            <h3 class="fw-bold mb-1">Xác nhận thanh toán</h3>
            <p class="mb-0 text-white-50">Vui lòng kiểm tra kỹ thông tin trước khi tiếp tục</p>
        </div>
        
        <div class="invoice-details">
            <div class="detail-row">
                <span class="text-muted fw-bold">Mã lớp học phần:</span>
                <span class="fw-bold text-primary fs-5">@ViewBag.MaLopHP</span>
            </div>
            <div class="detail-row">
                <span class="text-muted fw-bold">Tên môn học:</span>
                <span class="fw-bold text-dark fs-5">@ViewBag.TenMon</span>
            </div>
            <div class="detail-row">
                <span class="text-muted fw-bold">Sinh viên:</span>
                <span class="fw-bold">@User.Identity.Name</span>
            </div>
            
            <div class="text-center mt-5">
                <p class="text-muted fw-bold text-uppercase mb-0">Tổng tiền cần thanh toán</p>
                <div class="amount-total">
                    @String.Format("{0:N0}", ViewBag.SoTien) <small class="fs-4 text-muted">VNĐ</small>
                </div>
            </div>

            <form action="@Url.Action("XacNhanThanhToan", "Student")" method="post" class="text-center mt-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maLopHP" value="@ViewBag.MaLopHP" />
                <input type="hidden" name="soTien" value="@ViewBag.SoTien" />
                
                <button type="submit" class="btn btn-primary btn-pay fw-bold text-white shadow">
                    <i class="fas fa-lock me-2"></i>Thanh toán an toàn với VNPay
                </button>
                
                <div class="mt-4">
                    <img src="https://cdn.haitrieu.com/wp-content/uploads/2022/10/Logo-VNPAY-QR-1.png" alt="VNPay" height="30" class="mx-2" />
                    <img src="https://upload.wikimedia.org/wikipedia/commons/4/41/Visa_Logo.png" alt="Visa" height="20" class="mx-2" />
                    <img src="https://upload.wikimedia.org/wikipedia/commons/a/a4/Mastercard_2019_logo.svg" alt="Mastercard" height="25" class="mx-2" />
                </div>
            </form>
        </div>
    </div>
</div>