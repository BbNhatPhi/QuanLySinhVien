@model StudentManagementSystem.Models.SinhVien
@{
    ViewBag.Title = "Thông Tin Cá Nhân";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="mb-4 text-center"><i class="fas fa-user-edit text-primary"></i> Hồ Sơ Sinh Viên</h2>

            @if (TempData["SuccessMsg"] != null)
            {
                <div class="alert alert-success fw-bold"><i class="fas fa-check-circle"></i> @TempData["SuccessMsg"]</div>
            }
            @if (TempData["ErrorMsg"] != null)
            {
                <div class="alert alert-danger fw-bold"><i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMsg"]</div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form action="@Url.Action("CapNhatThongTin", "Student")" method="post">
                        <!-- Thông tin cứng: Không cho sửa (Dùng readonly) -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold text-muted">Mã Sinh Viên</label>
                                <input type="text" name="MaSV" class="form-control bg-light" value="@Model.MaSV" readonly />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label fw-bold text-muted">Họ và Tên</label>
                                <input type="text" class="form-control bg-light" value="@Model.HoTen" readonly />
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted">Ngày Sinh</label>
                                <input type="text" class="form-control bg-light" value="@(Model.NgaySinh.HasValue ? Model.NgaySinh.Value.ToString("dd/MM/yyyy") : "")" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted">Giới Tính</label>
                                <input type="text" class="form-control bg-light" value="@Model.GioiTinh" readonly />
                            </div>
                        </div>

                        <hr class="mb-4" />
                        <h5 class="text-primary mb-3">Thông Tin Liên Hệ (Có thể thay đổi)</h5>

                        <!-- Thông tin mềm: Cho phép sinh viên tự sửa -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Email</label>
                                <input type="email" name="Email" class="form-control" value="@Model.Email" placeholder="Nhập địa chỉ email" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Số Điện Thoại</label>
                                <input type="text" name="SoDienThoai" class="form-control" value="@Model.SoDienThoai" placeholder="Nhập số điện thoại" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Địa Chỉ Thường Trú / Tạm Trú</label>
                            <input type="text" name="DiaChi" class="form-control" value="@Model.DiaChi" placeholder="Nhập địa chỉ của bạn" />
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-primary px-5 fw-bold"><i class="fas fa-save"></i> Lưu Thay Đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>