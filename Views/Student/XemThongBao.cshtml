@model List<StudentManagementSystem.Models.ThongBao>
@{
    ViewBag.Title = "Bảng Thông Báo";
}

<div class="container-fluid px-4 mt-4 mb-5">

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <div>
            <h2 class="mb-0 fw-bold text-dark">
                <i class="fas fa-bullhorn text-danger me-2"></i>Thông Báo Từ Nhà Trường
            </h2>
            <nav aria-label="breadcrumb" class="mt-1">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Student")" class="text-decoration-none">Trang chủ</a></li>
                    <li class="breadcrumb-item active">Thông Báo</li>
                </ol>
            </nav>
        </div>
        @if (Model != null && Model.Count > 0)
        {
            <span class="badge bg-danger fs-6 px-3 py-2">
                <i class="fas fa-bell me-1"></i>@Model.Count thông báo
            </span>
        }
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <!-- Latest notice highlight -->
        <div class="alert alert-danger border-0 shadow-sm d-flex gap-3 align-items-start mb-4">
            <i class="fas fa-exclamation-circle fa-lg mt-1 text-danger"></i>
            <div>
                <strong>Thông báo mới nhất:</strong> @Model.First().TieuDe
                <span class="text-muted small ms-2">— @Model.First().NgayDang.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
        </div>

        <!-- Accordion -->
        <div class="card shadow border-0">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="fas fa-list me-2"></i>Danh Sách Thông Báo</h6>
                <span class="badge bg-secondary">@Model.Count mục</span>
            </div>
            <div class="card-body p-0">
                <div class="accordion accordion-flush" id="accordionThongBao">
                    @{
                        int index = 0;
                        foreach (var item in Model)
                        {
                            string collapseId = "collapse" + item.MaTB;
                            string headingId = "heading" + item.MaTB;
                            bool isFirst = (index == 0);
                    }
                    <div class="accordion-item border-bottom">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button @(isFirst ? "" : "collapsed") py-3 fw-semibold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#@collapseId"
                                    aria-expanded="@(isFirst ? "true" : "false")"
                                    aria-controls="@collapseId">
                                <div class="d-flex align-items-center gap-2 w-100 me-3">
                                    @if (isFirst)
                                    {
                                        <span class="badge bg-danger flex-shrink-0">Mới</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary flex-shrink-0">TB</span>
                                    }
                                    <span class="text-dark">@item.TieuDe</span>
                                    <span class="ms-auto text-muted small fw-normal flex-shrink-0 d-none d-md-inline">
                                        <i class="far fa-clock me-1"></i>@item.NgayDang.ToString("dd/MM/yyyy")
                                    </span>
                                </div>
                            </button>
                        </h2>
                        <div id="@collapseId"
                             class="accordion-collapse collapse @(isFirst ? "show" : "")"
                             aria-labelledby="@headingId"
                             data-bs-parent="#accordionThongBao">
                            <div class="accordion-body bg-light">
                                <div class="d-flex justify-content-between flex-wrap gap-2 mb-3 pb-2 border-bottom text-muted small">
                                    <span>
                                        <i class="fas fa-user-edit me-1 text-primary"></i>
                                        Đăng bởi: <strong class="text-dark">@item.NguoiDang</strong>
                                    </span>
                                    <span>
                                        <i class="far fa-clock me-1 text-primary"></i>
                                        Ngày đăng: <strong class="text-dark">@item.NgayDang.ToString("dd/MM/yyyy HH:mm")</strong>
                                    </span>
                                </div>
                                <p class="text-dark mb-0 lh-lg" style="white-space: pre-wrap;">@item.NoiDung</p>
                            </div>
                        </div>
                    </div>
                    @{
                            index++;
                        }
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="fas fa-bell-slash fa-3x text-secondary mb-3"></i>
                <h5 class="text-muted">Không có thông báo mới</h5>
                <p class="text-muted small">Hiện tại không có thông báo nào mới từ nhà trường.</p>
            </div>
        </div>
    }

</div>