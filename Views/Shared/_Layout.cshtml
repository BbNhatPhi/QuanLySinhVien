@{
    var pageTitle = ViewBag.Title != null ? ViewBag.Title.ToString() : "Trang chủ";
    var userName = User.Identity.Name ?? "";
    var avatarChar = !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "U";
    var roleLabel = User.IsInRole("Admin") ? "Quản trị viên"
        : User.IsInRole("GiangVien") ? "Giảng viên"
        : User.IsInRole("NhanVien") ? "Nhân viên đào tạo"
        : "Sinh viên";
}
@functions {
    string Nav(string controller, string action)
    {
        var c = ViewContext.RouteData.Values["controller"] as string;
        var a = ViewContext.RouteData.Values["action"] as string;
        return string.Equals(c, controller, StringComparison.OrdinalIgnoreCase)
            && string.Equals(a, action, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" />
</head>
<body>
    @if (TempData["SuccessMsg"] != null || TempData["Success"] != null || TempData["ErrorMsg"] != null || TempData["Error"] != null || TempData["WarningMsg"] != null || TempData["Warning"] != null)
    {
        <div class="toast-container">
            @if (TempData["SuccessMsg"] != null) { <div class="toast-item toast-success"><i class="fas fa-check-circle"></i> @TempData["SuccessMsg"]</div> }
            @if (TempData["Success"] != null) { <div class="toast-item toast-success"><i class="fas fa-check-circle"></i> @TempData["Success"]</div> }
            @if (TempData["ErrorMsg"] != null) { <div class="toast-item toast-danger"><i class="fas fa-circle-exclamation"></i> @TempData["ErrorMsg"]</div> }
            @if (TempData["Error"] != null) { <div class="toast-item toast-danger"><i class="fas fa-circle-exclamation"></i> @TempData["Error"]</div> }
            @if (TempData["WarningMsg"] != null) { <div class="toast-item toast-warning"><i class="fas fa-triangle-exclamation"></i> @TempData["WarningMsg"]</div> }
            @if (TempData["Warning"] != null) { <div class="toast-item toast-warning"><i class="fas fa-triangle-exclamation"></i> @TempData["Warning"]</div> }
        </div>
    }

    <div class="app">
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <div class="logo"><i class="fas fa-university"></i></div>
                <div class="brand-text">
                    <div class="brand-title">ĐH Nguyễn Tất Thành</div>
                    <div class="brand-sub">Cổng Đào tạo</div>
                </div>
            </div>

            <div class="sidebar-profile">
                <div class="avatar">@avatarChar</div>
                <div>
                    <div class="p-name">@userName</div>
                    <span class="p-role">@roleLabel</span>
                </div>
            </div>

            <nav class="sidebar-menu">
                @if (User.IsInRole("Admin"))
                {
                    <div class="menu-group">Tổng quan</div>
                    <a href="@Url.Action("Index","Admin")" class="menu-link @Nav("Admin","Index")"><i class="fas fa-chart-pie"></i> Thống kê</a>

                    <div class="menu-group">Quản lý hệ thống</div>
                    <a href="@Url.Action("ManageUsers","Admin")" class="menu-link @Nav("Admin","ManageUsers")"><i class="fas fa-users-gear"></i> Tài khoản</a>
                    <a href="@Url.Action("ManageKhoa","Admin")" class="menu-link @Nav("Admin","ManageKhoa")"><i class="fas fa-building-columns"></i> Khoa</a>
                    <a href="@Url.Action("ManageNganh","Admin")" class="menu-link @Nav("Admin","ManageNganh")"><i class="fas fa-graduation-cap"></i> Ngành học</a>
                    <a href="@Url.Action("ManagePhongHoc","Admin")" class="menu-link @Nav("Admin","ManagePhongHoc")"><i class="fas fa-chalkboard-user"></i> Phòng học</a>

                    <div class="menu-group">Dữ liệu</div>
                    <a href="@Url.Action("BackupData","Admin")" class="menu-link @Nav("Admin","BackupData")"><i class="fas fa-database"></i> Sao lưu</a>
                }
                else if (User.IsInRole("GiangVien"))
                {
                    <div class="menu-group">Giảng dạy</div>
                    <a href="@Url.Action("Index","Teacher")" class="menu-link @Nav("Teacher","Index")"><i class="fas fa-calendar-days"></i> Lịch giảng dạy</a>
                    <a href="@Url.Action("XemLop","Teacher")" class="menu-link @Nav("Teacher","XemLop")"><i class="fas fa-users"></i> Danh sách lớp</a>
                    <a href="@Url.Action("ChonLopNhapDiem","Teacher")" class="menu-link @Nav("Teacher","ChonLopNhapDiem")"><i class="fas fa-pen-to-square"></i> Nhập điểm</a>
                    <a href="@Url.Action("ChonLopDiemDanh","Teacher")" class="menu-link @Nav("Teacher","ChonLopDiemDanh")"><i class="fas fa-clipboard-user"></i> Điểm danh</a>
                    <a href="@Url.Action("ChonLopInDiem","Teacher")" class="menu-link @Nav("Teacher","ChonLopInDiem")"><i class="fas fa-print"></i> In bảng điểm</a>
                }
                else if (User.IsInRole("NhanVien"))
                {
                    <div class="menu-group">Đào tạo</div>
                    <a href="@Url.Action("Index","Staff")" class="menu-link @Nav("Staff","Index")"><i class="fas fa-user-graduate"></i> Sinh viên</a>
                    <a href="@Url.Action("GiangVienList","Staff")" class="menu-link @Nav("Staff","GiangVienList")"><i class="fas fa-user-tie"></i> Giảng viên</a>
                    <a href="@Url.Action("ManageMonHoc","Staff")" class="menu-link @Nav("Staff","ManageMonHoc")"><i class="fas fa-book"></i> Môn học</a>
                    <a href="@Url.Action("LopHocPhanList","Staff")" class="menu-link @Nav("Staff","LopHocPhanList")"><i class="fas fa-layer-group"></i> Lớp học phần</a>
                    <a href="@Url.Action("TKBList","Staff")" class="menu-link @Nav("Staff","TKBList")"><i class="fas fa-calendar-plus"></i> Thời khóa biểu</a>
                    <a href="@Url.Action("ManageLichThi","Staff")" class="menu-link @Nav("Staff","ManageLichThi")"><i class="fas fa-calendar-check"></i> Lịch thi</a>
                    <a href="@Url.Action("ManageDiemRenLuyen","Staff")" class="menu-link @Nav("Staff","ManageDiemRenLuyen")"><i class="fas fa-medal"></i> Điểm rèn luyện</a>

                    <div class="menu-group">Hành chính</div>
                    <a href="@Url.Action("ManageThongBao","Staff")" class="menu-link @Nav("Staff","ManageThongBao")"><i class="fas fa-bullhorn"></i> Thông báo</a>
                    <a href="@Url.Action("QuanLyYeuCau","Staff")" class="menu-link @Nav("Staff","QuanLyYeuCau")"><i class="fas fa-file-signature"></i> Duyệt giấy tờ</a>
                }
                else if (User.IsInRole("SinhVien"))
                {
                    <div class="menu-group">Học tập</div>
                    <a href="@Url.Action("Index","Student")" class="menu-link @Nav("Student","Index")"><i class="fas fa-calendar-days"></i> Thời khóa biểu</a>
                    <a href="@Url.Action("DangKyHocPhan","Student")" class="menu-link @Nav("Student","DangKyHocPhan")"><i class="fas fa-hand-pointer"></i> Đăng ký học phần</a>
                    <a href="@Url.Action("XemDiem","Student")" class="menu-link @Nav("Student","XemDiem")"><i class="fas fa-chart-column"></i> Kết quả học tập</a>
                    <a href="@Url.Action("TienDoHocTap","Student")" class="menu-link @Nav("Student","TienDoHocTap")"><i class="fas fa-chart-pie"></i> Tiến độ học tập</a>
                    <a href="@Url.Action("XemLichThi","Student")" class="menu-link @Nav("Student","XemLichThi")"><i class="fas fa-calendar-xmark"></i> Lịch thi</a>
                    <a href="@Url.Action("XemDiemRenLuyen","Student")" class="menu-link @Nav("Student","XemDiemRenLuyen")"><i class="fas fa-medal"></i> Điểm rèn luyện</a>

                    <div class="menu-group">Dịch vụ</div>
                    <a href="@Url.Action("XemHocPhi","Student")" class="menu-link @Nav("Student","XemHocPhi")"><i class="fas fa-credit-card"></i> Học phí</a>
                    <a href="@Url.Action("DichVuHanhChinh","Student")" class="menu-link @Nav("Student","DichVuHanhChinh")"><i class="fas fa-university"></i> Dịch vụ hành chính</a>
                    <a href="@Url.Action("DanhGiaGiangVien","Student")" class="menu-link @Nav("Student","DanhGiaGiangVien")"><i class="fas fa-star"></i> Đánh giá giảng viên</a>

                    <div class="menu-group">Thông tin</div>
                    <a href="@Url.Action("XemThongBao","Student")" class="menu-link @Nav("Student","XemThongBao")"><i class="fas fa-bell"></i> Thông báo</a>
                    <a href="@Url.Action("CapNhatThongTin","Student")" class="menu-link @Nav("Student","CapNhatThongTin")"><i class="fas fa-user-pen"></i> Hồ sơ cá nhân</a>
                }
            </nav>

            <div class="sidebar-footer">
                <a href="@Url.Action("Logout","Account")" class="btn-logout"><i class="fas fa-right-from-bracket"></i> Đăng xuất</a>
            </div>
        </aside>

        <main class="main">
            <header class="topbar">
                <button class="btn-toggle" id="sidebarToggle" type="button" aria-label="Mở menu"><i class="fas fa-bars"></i></button>
                <div>
                    <div class="topbar-title">@pageTitle</div>
                    <div class="topbar-breadcrumb">Cổng thông tin đào tạo / @roleLabel</div>
                </div>
                <div class="topbar-right d-flex align-items-center">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-semibold d-none d-md-inline-block me-3">
                        <i class="fas fa-graduation-cap me-1 text-primary"></i> HK1 (2025 - 2026)
                    </span>
                    <div class="dropdown">
                        <a href="#" class="user-chip dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar">@avatarChar</span>
                            <span class="u-name">@userName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li>
                                <a class="dropdown-item" href="@Url.Action("ChangePassword", "Account")">
                                    <i class="fas fa-key me-2 text-warning"></i> Đổi mật khẩu
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account")">
                                    <i class="fas fa-right-from-bracket me-2"></i> Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <div class="page-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var btn = document.getElementById('sidebarToggle');
            var sidebar = document.getElementById('sidebar');
            var overlay = document.getElementById('sidebarOverlay');
            function toggle() {
                sidebar.classList.toggle('open');
                overlay.classList.toggle('show');
            }
            if (btn) btn.addEventListener('click', toggle);
            if (overlay) overlay.addEventListener('click', toggle);
        })();
    </script>
    <script>
        // Tự động ẩn toast thông báo sau vài giây
        (function () {
            var items = document.querySelectorAll('.toast-item');
            items.forEach(function (item) {
                setTimeout(function () {
                    item.classList.add('hide');
                    setTimeout(function () { item.remove(); }, 400);
                }, 4500);
            });
        })();
    </script>
    <script>
        // Tìm kiếm nhanh trong bảng (gõ để lọc dòng)
        document.querySelectorAll('[data-search-table]').forEach(function (input) {
            var table = document.getElementById(input.getAttribute('data-search-table'));
            if (!table) return;
            input.addEventListener('keyup', function () {
                var q = input.value.toLowerCase();
                table.querySelectorAll('tbody tr').forEach(function (row) {
                    row.style.display = row.textContent.toLowerCase().indexOf(q) > -1 ? '' : 'none';
                });
            });
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>