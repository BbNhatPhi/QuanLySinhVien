<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Hệ thống Quản lý Đào tạo</title>
    <!-- Nhúng Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .sidebar {
            min-height: 100vh;
            background-color: #2c3e50;
            color: white;
        }

            .sidebar .brand {
                background-color: #1a252f;
                padding: 20px;
                text-align: center;
                font-weight: bold;
                font-size: 1.2rem;
            }

            .sidebar a.menu-link {
                color: #ecf0f1;
                text-decoration: none;
                padding: 15px 20px;
                display: block;
                transition: 0.3s;
            }

                .sidebar a.menu-link:hover {
                    background-color: #34495e;
                    border-left: 4px solid #3498db;
                }

                .sidebar a.menu-link i {
                    width: 25px;
                }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar Menu Phân Quyền Theo Sơ Đồ -->
        <div class="sidebar p-0 col-md-2 d-none d-md-block shadow">
            <div class="brand text-uppercase text-warning">
                ĐH. Nguyễn Tất Thành
            </div>

            @if (User.IsInRole("Admin"))
            {
                <a href="@Url.Action("Index", "Admin")" class="menu-link"><i class="fas fa-chart-pie"></i> Thống kê</a>
                <a href="@Url.Action("ManageUsers", "Admin")" class="menu-link"><i class="fas fa-users-cog"></i> Quản lý tài khoản</a>
                <a href="@Url.Action("ManageKhoa", "Admin")" class="menu-link"><i class="fas fa-building"></i> Quản lý khoa</a>
                <a href="@Url.Action("ManageNganh", "Admin")" class="menu-link"><i class="fas fa-graduation-cap"></i> Quản lý ngành</a>
                <!-- MENU MỚI THÊM: QUẢN LÝ PHÒNG HỌC -->
                <a href="@Url.Action("ManagePhongHoc", "Admin")" class="menu-link"><i class="fas fa-chalkboard"></i> Quản lý phòng học</a>
                <a href="@Url.Action("BackupData", "Admin")" class="menu-link"><i class="fas fa-database"></i> Backup</a>
            }
            else if (User.IsInRole("GiangVien"))
            {
                <a href="@Url.Action("Index", "Teacher")" class="menu-link"><i class="fas fa-calendar-alt"></i> Xem lịch dạy</a>
                <a href="@Url.Action("XemLop", "Teacher")" class="menu-link"><i class="fas fa-users"></i> Xem danh sách lớp</a>
                <a href="@Url.Action("ChonLopNhapDiem", "Teacher")" class="menu-link"><i class="fas fa-edit"></i> Chấm điểm</a>
                <a href="@Url.Action("ChonLopDiemDanh", "Teacher")" class="menu-link"><i class="fas fa-user-check"></i> Điểm danh</a>
                <a href="@Url.Action("ChonLopInDiem", "Teacher")" class="menu-link"><i class="fas fa-print"></i> In bảng điểm</a>
            }
            else if (User.IsInRole("NhanVien"))
            {
                <a href="@Url.Action("Index", "Staff")" class="menu-link"><i class="fas fa-user-graduate"></i> Quản lý sinh viên</a>
                <!-- MENU MỚI THÊM: QUẢN LÝ ĐIỂM RÈN LUYỆN -->
                <a href="@Url.Action("ManageDiemRenLuyen", "Staff")" class="menu-link"><i class="fas fa-medal"></i> Quản lý điểm rèn luyện</a>
                <a href="@Url.Action("ClassList", "Staff")" class="menu-link"><i class="fas fa-chalkboard-teacher"></i> Quản lý lớp</a>
                <a href="@Url.Action("LopHocPhanList", "Staff")" class="menu-link"><i class="fas fa-layer-group"></i> Quản lý Lớp học phần</a>
                <a href="@Url.Action("TKBList", "Staff")" class="menu-link"><i class="fas fa-calendar-plus"></i> Lập TKB</a>
                <a href="@Url.Action("ManageMonHoc", "Staff")" class="menu-link"><i class="fas fa-book"></i> Quản lý môn học</a>
                <a href="@Url.Action("GiangVienList", "Staff")" class="menu-link"><i class="fas fa-user-tie"></i> Quản lý GV</a>
                <a href="@Url.Action("ManageLichThi", "Staff")" class="menu-link"><i class="fas fa-calendar-check"></i> Lên lịch thi</a>
                <a href="@Url.Action("ManageThongBao", "Staff")" class="menu-link"><i class="fas fa-bullhorn"></i> Đăng thông báo</a>
                <!-- ĐÃ CHỈNH LẠI CLASS CHO KHỚP VÀ XÓA DẤU "<" -->
                <a href="@Url.Action("QuanLyYeuCau", "Staff")" class="menu-link"><i class="fas fa-file-signature"></i> Duyệt giấy tờ / Hành chính</a>
            }
            else if (User.IsInRole("SinhVien"))
            {
                <a href="@Url.Action("Index", "Student")" class="menu-link"><i class="fas fa-calendar-check"></i> Xem TKB</a>
                <a href="@Url.Action("DangKyHocPhan", "Student")" class="menu-link"><i class="fas fa-mouse-pointer"></i> Đăng ký học phần</a>
                <a href="@Url.Action("XemDiem", "Student")" class="menu-link"><i class="fas fa-chart-bar"></i> Kết quả học tập</a>
                <a href="@Url.Action("XemLichThi", "Student")" class="menu-link"><i class="fas fa-calendar-times"></i> Xem Lịch thi</a>
                <a href="@Url.Action("XemHocPhi", "Student")" class="menu-link"><i class="fas fa-credit-card"></i> Thanh toán học phí</a>
                <a href="@Url.Action("XemThongBao", "Student")" class="menu-link"><i class="fas fa-bell"></i> Bảng thông báo</a>
                <a href="@Url.Action("CapNhatThongTin", "Student")" class="menu-link"><i class="fas fa-user-edit"></i> Cập nhật hồ sơ</a>
                <a href="@Url.Action("TienDoHocTap", "Student")" class="menu-link"><i class="fas fa-chart-pie"></i> Tiến độ học tập</a>
                <a href="@Url.Action("DichVuHanhChinh", "Student")" class="menu-link"><i class="fas fa-university"></i> Dịch vụ Hành chính</a>
                <a href="@Url.Action("DanhGiaGiangVien", "Student")" class="menu-link"><i class="fas fa-poll"></i> Đánh giá Giảng viên</a>
                <a href="@Url.Action("XemDiemRenLuyen", "Student")" class="menu-link"><i class="fas fa-medal"></i> Xem Điểm rèn luyện</a>
            }

        </div>

        <!-- Main Content Area -->
        <div class="col-md-10 p-4" style="background-color: #f4f7f6; min-height: 100vh;">
            <!-- Header Bar -->
            <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 shadow-sm rounded border-start border-4 border-primary">
                <h5 class="m-0 text-secondary fw-bold">Cổng thông tin Đào tạo</h5>

                <!-- Dropdown Menu Người Dùng -->
                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" id="dropdownUser" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="me-2 text-primary fw-bold">Xin chào, @User.Identity.Name!</span>
                        <i class="fas fa-user-circle fa-2x text-secondary"></i>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="dropdownUser">
                        <!-- Nút Đổi mật khẩu -->
                        <li>
                            <a class="dropdown-item fw-bold text-dark" href="@Url.Action("ChangePassword", "Account")">
                                <i class="fas fa-key text-warning me-2"></i> Đổi mật khẩu
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <!-- Nút Đăng xuất -->
                        <li>
                            <a class="dropdown-item fw-bold text-danger" href="@Url.Action("Logout", "Account")">
                                <i class="fas fa-sign-out-alt me-2"></i> Đăng xuất
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Nội dung thay đổi theo từng trang -->
            @RenderBody()
        </div>
    </div>

    <!-- Cần load Bundle Bootstrap JS để Dropdown menu hoạt động -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>