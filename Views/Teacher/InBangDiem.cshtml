@model IEnumerable<StudentManagementSystem.Models.SinhVienDiem>
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head>
    <title>In Bảng Điểm - @ViewBag.MaLopTC</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* CSS Ẩn nút In khi đang in ra giấy */
        @@media print {
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body class="p-5">
    <div class="text-center mb-4">
        <h4>BỘ GIÁO DỤC VÀ ĐÀO TẠO</h4>
        <h3>TRƯỜNG ĐẠI HỌC NGUYỄN TẤT THÀNH</h3>
        <hr style="width: 300px; margin: auto; border: 1px solid black;" />
        <h2 class="mt-4 fw-bold">BẢNG ĐIỂM KẾT THÚC HỌC PHẦN</h2>
        <h5>Mã lớp tín chỉ: @ViewBag.MaLopTC</h5>
    </div>

    <table class="table table-bordered border-dark text-center align-middle">
        <thead>
            <tr>
                <th>STT</th>
                <th>Mã SV</th>
                <th class="text-start">Họ và Tên</th>
                <th>Điểm CC (10%)</th>
                <th>Điểm GK (30%)</th>
                <th>Điểm CK (60%)</th>
                <th>TỔNG KẾT</th>
            </tr>
        </thead>
        <tbody>
            @{ int stt = 1; }
            @foreach (var sv in Model)
            {
                <tr>
                    <td>@(stt++)</td>
                    <td>@sv.MaSV</td>
                    <td class="text-start">@sv.HoTen</td>
                    <td>@sv.DiemCC</td>
                    <td>@sv.DiemGK</td>
                    <td>@sv.DiemCK</td>
                    <td class="fw-bold">@sv.DiemTong</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="row mt-5 text-center">
        <div class="col-6"></div>
        <div class="col-6">
            <p>Ngày ..... tháng ..... năm 20...</p>
            <p class="fw-bold">GIẢNG VIÊN GIẢNG DẠY</p>
            <br /><br /><br />
            <p>(Ký và ghi rõ họ tên)</p>
        </div>
    </div>

    <div class="text-center mt-5 no-print">
        <!-- Lệnh window.print() dùng để gọi máy in của trình duyệt -->
        <button class="btn btn-success px-5 py-2" onclick="window.print()"><i class="fas fa-print"></i> TIẾN HÀNH IN</button>
    </div>
</body>
</html>