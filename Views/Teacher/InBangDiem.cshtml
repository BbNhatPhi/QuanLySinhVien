@model IEnumerable<StudentManagementSystem.Models.SinhVienDiem>
@{ 
    Layout = null; 
    var dsDiem = Model != null ? Model.ToList() : new List<StudentManagementSystem.Models.SinhVienDiem>();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bảng Điểm Học Phần - @ViewBag.MaLopTC</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Be Vietnam Pro', 'Times New Roman', serif;
            color: #000;
        }
        @@media print {
            .no-print {
                display: none !important;
            }
            body {
                padding: 0 !important;
            }
        }
    </style>
</head>
<body class="p-4 p-md-5">
    <div class="no-print mb-4 d-flex justify-content-between align-items-center bg-light p-3 rounded border">
        <span class="text-muted"><i class="fas fa-info-circle me-1"></i>Trang in chuẩn A4 theo phôi quản lý đào tạo đại học.</span>
        <div>
            <button onclick="window.print()" class="btn btn-primary btn-sm px-4 fw-bold">
                In Bảng Điểm (Ctrl + P)
            </button>
            <button onclick="window.close()" class="btn btn-outline-secondary btn-sm px-3 ms-2">
                Đóng
            </button>
        </div>
    </div>

    <!-- TIÊU NGỮ & TÊN TRƯỜNG -->
    <div class="row align-items-start mb-4">
        <div class="col-6 text-center">
            <h6 class="text-uppercase mb-1 fw-bold">BỘ GIÁO DỤC VÀ ĐÀO TẠO</h6>
            <h5 class="text-uppercase fw-bold mb-1">TRƯỜNG ĐẠI HỌC NGUYỄN TẤT THÀNH</h5>
            <div style="width: 140px; margin: auto; border-top: 1.5px solid #000;"></div>
        </div>
        <div class="col-6 text-center">
            <h6 class="text-uppercase mb-1 fw-bold">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</h6>
            <h6 class="fw-bold mb-1">Độc lập - Tự do - Hạnh phúc</h6>
            <div style="width: 160px; margin: auto; border-top: 1.5px solid #000;"></div>
        </div>
    </div>

    <div class="text-center my-4">
        <h3 class="fw-bold text-uppercase mb-2">BẢNG ĐIỂM TỔNG KẾT HỌC PHẦN</h3>
        <p class="mb-0 fs-6">Mã lớp học phần: <strong>@ViewBag.MaLopTC</strong> | Học kỳ: <strong>HK1 (2025 - 2026)</strong></p>
    </div>

    <table class="table table-bordered border-dark text-center align-middle mb-4">
        <thead class="table-light border-dark">
            <tr>
                <th style="width: 50px;">STT</th>
                <th style="width: 130px;">Mã Sinh Viên</th>
                <th class="text-start">Họ và Tên Sinh Viên</th>
                <th style="width: 90px;">CC (10%)</th>
                <th style="width: 90px;">GK (30%)</th>
                <th style="width: 90px;">CK (60%)</th>
                <th style="width: 100px;">Tổng Kết</th>
                <th style="width: 90px;">Điểm Chữ</th>
                <th style="width: 110px;">Ghi Chú</th>
            </tr>
        </thead>
        <tbody>
            @{ 
                int stt = 1; 
                int passCount = 0;
            }
            @if (!dsDiem.Any())
            {
                <tr><td colspan="9" class="py-4 text-muted">Lớp học phần chưa có danh sách sinh viên.</td></tr>
            }
            @foreach (var sv in dsDiem)
            {
                bool isPass = sv.DiemTong >= 4.0;
                if (isPass) { passCount++; }
                string diemChu = sv.DiemTong >= 8.5 ? "A" : (sv.DiemTong >= 7.0 ? "B" : (sv.DiemTong >= 5.5 ? "C" : (sv.DiemTong >= 4.0 ? "D" : "F")));

                <tr>
                    <td>@(stt++)</td>
                    <td class="fw-bold">@sv.MaSV</td>
                    <td class="text-start">@sv.HoTen</td>
                    <td>@sv.DiemCC.ToString("0.0")</td>
                    <td>@sv.DiemGK.ToString("0.0")</td>
                    <td>@sv.DiemCK.ToString("0.0")</td>
                    <td class="fw-bold">@sv.DiemTong.ToString("0.0")</td>
                    <td class="fw-bold">@diemChu</td>
                    <td>
                        @(isPass ? "Đạt" : "Học lại")
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="row text-muted small mb-4">
        <div class="col-12">
            <em>* Tổng số sinh viên: <strong>@dsDiem.Count</strong> | Đạt: <strong>@passCount</strong> | Chưa đạt: <strong>@(dsDiem.Count - passCount)</strong></em>
        </div>
    </div>

    <!-- KHỐI CHỮ KÝ XÁC NHẬN -->
    <div class="row mt-5 text-center">
        <div class="col-4">
            <p class="fw-bold mb-1">TRƯỞNG KHOA / VIỆN</p>
            <small class="text-muted">(Ký và ghi rõ họ tên)</small>
            <br /><br /><br /><br />
        </div>
        <div class="col-4">
            <p class="fw-bold mb-1">PHÒNG ĐÀO TẠO</p>
            <small class="text-muted">(Xác nhận bảng điểm)</small>
            <br /><br /><br /><br />
        </div>
        <div class="col-4">
            <p class="mb-1"><em>Ngày ..... tháng ..... năm 20...</em></p>
            <p class="fw-bold mb-1">GIẢNG VIÊN PHỤ TRÁCH</p>
            <small class="text-muted">(Ký và ghi rõ họ tên)</small>
            <br /><br /><br /><br />
        </div>
    </div>
</body>
</html>