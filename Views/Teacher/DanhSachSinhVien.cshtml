@model IEnumerable<StudentManagementSystem.Models.SinhVienLop>
@{
    ViewBag.Title = "Danh Sách Sinh Viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-user-check text-primary"></i> Danh sách lớp: @ViewBag.MaLopTC</h2>
    <a href="@Url.Action("XemLop", "Teacher")" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay lại</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow border-0">
    <div class="card-body">
        <form action="@Url.Action("LuuDiemDanh", "Teacher")" method="post">
            <input type="hidden" name="maLopTC" value="@ViewBag.MaLopTC" />

            <table class="table table-hover table-bordered align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>Mã SV</th>
                        <th class="text-start">Họ Tên</th>
                        <th>Giới Tính</th>
                        <th>Email</th>
                        <th>Điểm CC hiện tại</th>
                        <th class="text-center" width="25%">Trạng Thái Điểm Danh</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sv in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold">@sv.MaSV</td>
                            <td>@sv.HoTen</td>
                            <td class="text-center">@sv.GioiTinh</td>
                            <td>@sv.Email</td>
                            <td class="text-center"><span class="badge bg-info text-dark fs-6">@sv.DiemCC</span></td>
                            <td class="text-center">
                                <!-- Đính kèm Mã SV ngầm để Controller biết sinh viên nào được chọn -->
                                <input type="hidden" name="maSV" value="@sv.MaSV" />

                                <!-- Thẻ select chọn trạng thái đi học / vắng -->
                                <select name="trangThaiVang" class="form-select border-info text-center fw-bold">
                                    <option value="Có mặt" class="text-success">Có mặt</option>
                                    <option value="Có phép" class="text-warning">Vắng có phép (-2đ)</option>
                                    <option value="Không phép" class="text-danger">Vắng không phép (-3đ)</option>
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="text-end mt-3">
                <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm"><i class="fas fa-clipboard-list"></i> LƯU ĐIỂM DANH & TRỪ ĐIỂM</button>
            </div>
        </form>
    </div>
</div>