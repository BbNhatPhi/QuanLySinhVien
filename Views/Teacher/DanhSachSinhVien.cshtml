@model IEnumerable<StudentManagementSystem.Models.SinhVienLop>
@{
    ViewBag.Title = "Danh Sách Sinh Viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-user-check text-primary"></i> Danh sách lớp: @ViewBag.MaLopTC</h2>
    <a href="@Url.Action("XemLop", "Teacher")" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay lại</a>
</div>

<div class="card shadow border-0">
    <div class="card-body">
        <form action="@Url.Action("LuuDiemDanh", "Teacher")" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="maLopTC" value="@ViewBag.MaLopTC" />

            <table class="table table-hover table-bordered align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>Mã SV</th>
                        <th class="text-start">Họ Tên</th>
                        <th>Giới Tính</th>
                        <th>Email</th>
                        <th>Điểm CC hiện tại</th>
                        <th class="text-center" width="35%">Trạng Thái Điểm Danh</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sv in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold">@sv.MaSV</td>
                            <td>@sv.HoTen</td>
                            <td class="text-center">@sv.GioiTinh</td>
                            <td>@sv.Email</td>
                            <td class="text-center"><span class="badge bg-info text-dark fs-6">@sv.DiemCC</span></td>
                            <td class="text-center">
                                <!-- Layout 3 ô tích (Radio Buttons) -->
                                <div class="d-flex justify-content-center gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="TrangThai_@sv.MaSV" id="comat_@sv.MaSV" value="Có mặt" checked>
                                        <label class="form-check-label text-success fw-bold" for="comat_@sv.MaSV">Có mặt</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="TrangThai_@sv.MaSV" id="cophep_@sv.MaSV" value="Có phép">
                                        <label class="form-check-label text-warning fw-bold" for="cophep_@sv.MaSV">Có phép</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="TrangThai_@sv.MaSV" id="khongphep_@sv.MaSV" value="Không phép">
                                        <label class="form-check-label text-danger fw-bold" for="khongphep_@sv.MaSV">Không phép</label>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="text-end mt-3">
                <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm"><i class="fas fa-clipboard-check"></i> LƯU ĐIỂM DANH</button>
            </div>
        </form>
    </div>
</div>