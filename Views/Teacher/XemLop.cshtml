@model IEnumerable<StudentManagementSystem.Models.LichDay>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string chucNang = ViewBag.ChucNang as string;
    string tieuDe = ViewBag.Title ?? "Các Lớp Đang Phụ Trách";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1 fw-bold text-dark">
            <i class="fas fa-chalkboard-user text-primary me-2"></i>@tieuDe
        </h2>
        <p class="text-muted small mb-0">Học kỳ 1 (2025–2026) | Danh sách học phần được phân công giảng dạy</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Teacher")" class="btn btn-outline-secondary btn-sm">
            <i class="fas fa-calendar-alt me-1"></i> Lịch giảng dạy
        </a>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm border-0 rounded-3 h-100 border-start border-4 border-primary">
                    <div class="card-body p-3 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary fs-6">@item.MaLopHP</span>
                            <span class="badge bg-light text-dark border">
                                <i class="fas fa-door-open text-primary me-1"></i>@item.PhongHoc
                            </span>
                        </div>
                        <h5 class="fw-bold text-dark mb-2">@item.TenMon</h5>
                        <p class="text-muted small mb-3">
                            @if (item.NgayHoc > 0)
                            {
                                <span><i class="fas fa-calendar-day text-secondary me-1"></i>Thứ @item.NgayHoc &bull; Ca @item.CaHoc</span>
                            }
                            else
                            {
                                <span class="fst-italic text-warning"><i class="fas fa-clock me-1"></i>Chưa xếp lịch học</span>
                            }
                        </p>
                        <div class="mt-auto pt-3 border-top d-flex flex-wrap gap-2">
                            @if (chucNang == "DiemDanh" || chucNang == null)
                            {
                                <a href="@Url.Action("DanhSachSinhVien", "Teacher", new { maLopTC = item.MaLopHP })" class="btn btn-outline-primary btn-sm flex-fill">
                                    <i class="fas fa-clipboard-user me-1"></i> Điểm danh
                                </a>
                            }
                            @if (chucNang == "NhapDiem" || chucNang == null)
                            {
                                <a href="@Url.Action("NhapDiem", "Teacher", new { maLopTC = item.MaLopHP })" class="btn btn-outline-warning text-dark btn-sm flex-fill">
                                    <i class="fas fa-edit me-1"></i> Nhập điểm
                                </a>
                            }
                            @if (chucNang == "InDiem" || chucNang == null)
                            {
                                <a href="@Url.Action("InBangDiem", "Teacher", new { maLopTC = item.MaLopHP })" target="_blank" class="btn btn-outline-secondary btn-sm" title="In Bảng Điểm">
                                    <i class="fas fa-print"></i>
                                </a>
                                <a href="@Url.Action("ExportDiemExcel", "Teacher", new { maLopTC = item.MaLopHP })" class="btn btn-outline-success btn-sm" title="Xuất File Excel">
                                    <i class="fas fa-file-excel"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="fas fa-folder-open fa-3x text-secondary opacity-50 mb-3"></i>
            <h5 class="text-muted fw-bold">Chưa có lớp học phần nào</h5>
            <p class="text-muted small">Hiện tại quý Thầy/Cô chưa được phân công phụ trách lớp học phần nào trong học kỳ này.</p>
        </div>
    </div>
}