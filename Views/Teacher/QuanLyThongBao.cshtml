@model List<StudentManagementSystem.Models.ThongBaoLop>
@{
    ViewBag.Title = "Quản lý Thông Báo Lớp";
}

<div class="hero-3d-banner p-4 mb-4 rounded-3 text-white">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold mb-2"><i class="fas fa-bullhorn me-2"></i>Bảng Tin Lớp Học</h2>
            <p class="mb-0 text-white-50">Lớp Học Phần: <strong class="text-white">@ViewBag.MaLopTC</strong></p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <a href="@Url.Action("XemLop", "Teacher")" class="btn btn-outline-light btn-3d"><i class="fas fa-arrow-left me-2"></i>Trở lại danh sách</a>
        </div>
    </div>
</div>

@if (TempData["SuccessMsg"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMsg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-4 mb-4">
        <div class="stat-card-3d h-100 p-4">
            <h4 class="fw-bold text-primary mb-4"><i class="fas fa-plus-circle me-2"></i>Đăng Thông Báo Mới</h4>
            <form action="@Url.Action("AddThongBaoLop", "Teacher")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maLopTC" value="@ViewBag.MaLopTC" />
                <div class="mb-3">
                    <label class="form-label fw-bold">Tiêu Đề <span class="text-danger">*</span></label>
                    <input type="text" name="TieuDe" class="form-control" required placeholder="Nhập tiêu đề..." />
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold">Nội Dung <span class="text-danger">*</span></label>
                    <textarea name="NoiDung" class="form-control" rows="5" required placeholder="Nhập chi tiết thông báo..."></textarea>
                </div>
                <button type="submit" class="btn btn-primary w-100 btn-3d"><i class="fas fa-paper-plane me-2"></i>Đăng Thông Báo</button>
            </form>
        </div>
    </div>

    <div class="col-lg-8 mb-4">
        <div class="glass-panel p-4 h-100" data-tilt-3d>
            <h4 class="fw-bold text-primary mb-4">Lịch Sử Thông Báo</h4>
            
            @if (Model != null && Model.Count > 0)
            {
                <div class="list-group">
                    @foreach (var tb in Model)
                    {
                        <div class="list-group-item list-group-item-action p-4 border-0 mb-3 rounded-3 shadow-sm bg-white" style="transition: transform 0.2s;">
                            <div class="d-flex w-100 justify-content-between mb-2">
                                <h5 class="mb-1 fw-bold text-dark">@tb.TieuDe</h5>
                                <small class="text-muted"><i class="fas fa-clock me-1"></i>@tb.NgayDang.ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                            <p class="mb-1 text-secondary">@tb.NoiDung</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-bell-slash fa-3x mb-3 text-secondary opacity-50"></i>
                    <p>Chưa có thông báo nào cho lớp này.</p>
                </div>
            }
        </div>
    </div>
</div>
