@{
    ViewBag.Title = "Đổi Mật Khẩu";
    var userInfo = ViewBag.UserInfo as StudentManagementSystem.Models.User;
    string homeUrl = Url.Action("Index", "Home");
    string roleName = userInfo != null ? userInfo.RoleName : (User.IsInRole("Admin") ? "Admin" : (User.IsInRole("GiangVien") ? "GiangVien" : (User.IsInRole("NhanVien") ? "NhanVien" : "SinhVien")));
    string roleBadge = "bg-secondary";
    string roleDisplay = "Người dùng";

    if (roleName == "Admin")
    {
        homeUrl = Url.Action("Index", "Admin");
        roleBadge = "bg-danger";
        roleDisplay = "Quản trị viên";
    }
    else if (roleName == "GiangVien")
    {
        homeUrl = Url.Action("Index", "Teacher");
        roleBadge = "bg-info text-dark";
        roleDisplay = "Giảng viên";
    }
    else if (roleName == "NhanVien")
    {
        homeUrl = Url.Action("Index", "Staff");
        roleBadge = "bg-warning text-dark";
        roleDisplay = "Nhân viên Đào tạo";
    }
    else if (roleName == "SinhVien")
    {
        homeUrl = Url.Action("Index", "Student");
        roleBadge = "bg-success";
        roleDisplay = "Sinh viên";
    }

    bool isDefaultPass = Session["MustChangePassword"] != null;
}

<div class="container-fluid px-4 py-3">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@homeUrl" class="text-decoration-none"><i class="fas fa-home me-1"></i>Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page"><i class="fas fa-key me-1 text-warning"></i>Đổi mật khẩu</li>
        </ol>
    </nav>

    @if (isDefaultPass)
    {
        <div class="alert alert-warning border-start border-4 border-warning shadow-sm mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-shield-halved fa-2x text-warning me-3"></i>
                <div>
                    <h6 class="alert-heading mb-1 fw-bold">Khuyến nghị bảo mật quan trọng!</h6>
                    <span class="small">Tài khoản của bạn hiện đang dùng mật khẩu khởi tạo mặc định. Vui lòng thiết lập mật khẩu mới để bảo vệ dữ liệu cá nhân.</span>
                </div>
            </div>
            <a href="@homeUrl" class="btn btn-sm btn-outline-secondary fw-semibold">
                <i class="fas fa-forward me-1"></i>Để sau, đến Trang chủ
            </a>
        </div>
    }

    @if (TempData["SuccessMsg"] != null)

    {
        <div class="alert alert-success border-start border-4 border-success shadow-sm mb-4 d-flex align-items-center" role="alert">
            <i class="fas fa-circle-check fa-2x text-success me-3"></i>
            <div>
                <h6 class="alert-heading mb-1 fw-bold">Cập nhật thành công!</h6>
                <span>@TempData["SuccessMsg"]</span>
            </div>
        </div>
    }

    @if (TempData["ErrorMsg"] != null)
    {
        <div class="alert alert-danger border-start border-4 border-danger shadow-sm mb-4 d-flex align-items-center" role="alert">
            <i class="fas fa-circle-exclamation fa-2x text-danger me-3"></i>
            <div>
                <h6 class="alert-heading mb-1 fw-bold">Không thể đổi mật khẩu!</h6>
                <span>@TempData["ErrorMsg"]</span>
            </div>
        </div>
    }

    <div class="row g-4">

        <!-- Cột trái: Thông tin tài khoản & Quy chuẩn an toàn -->
        <div class="col-lg-4 col-md-5">
            <!-- Card hồ sơ -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-user-shield me-2"></i>Tài Khoản Xác Thực</h6>
                </div>
                <div class="card-body text-center p-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 text-primary mb-3" style="width: 72px; height: 72px; font-size: 1.8rem; font-weight: bold;">
                        @(User.Identity.Name.Length > 0 ? User.Identity.Name.Substring(0, 1).ToUpper() : "U")
                    </div>
                    <h5 class="fw-bold mb-1 text-dark">@(userInfo != null && !string.IsNullOrEmpty(userInfo.HoTen) ? userInfo.HoTen : User.Identity.Name)</h5>
                    <p class="text-muted small mb-2"><i class="fas fa-id-badge me-1"></i>Tên đăng nhập: <strong class="text-dark">@User.Identity.Name</strong></p>
                    <span class="badge @roleBadge px-3 py-2 fs-7 mb-3">@roleDisplay</span>

                    <hr class="my-3" />

                    <div class="text-start small">
                        @if (userInfo != null && !string.IsNullOrEmpty(userInfo.Email))
                        {
                            <div class="d-flex align-items-center mb-2 text-muted">
                                <i class="fas fa-envelope text-primary me-2" style="width: 16px;"></i>
                                <span class="text-truncate">@userInfo.Email</span>
                            </div>
                        }
                        <div class="d-flex align-items-center text-muted">
                            <i class="fas fa-clock text-info me-2" style="width: 16px;"></i>
                            <span>Đăng nhập lúc: @DateTime.Now.ToString("HH:mm - dd/MM/yyyy")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card hướng dẫn đặt mật khẩu -->
            <div class="card shadow-sm border-0 border-start border-4 border-info">
                <div class="card-body p-3">
                    <h6 class="fw-bold text-dark mb-2"><i class="fas fa-lightbulb text-warning me-2"></i>Quy chuẩn mật khẩu an toàn</h6>
                    <ul class="list-unstyled small text-muted mb-0">
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Độ dài tối thiểu <strong>6 ký tự</strong> (khuyến nghị từ 8 ký tự).</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Nên kết hợp <strong>chữ in hoa</strong> (A-Z) và <strong>chữ thường</strong> (a-z).</li>
                        <li class="mb-2"><i class="fas fa-check text-success me-2"></i>Nên có ít nhất <strong>1 chữ số</strong> (0-9) hoặc ký tự đặc biệt.</li>
                        <li><i class="fas fa-times text-danger me-2"></i>Không dùng ngày sinh hoặc số điện thoại làm mật khẩu.</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Cột phải: Form đổi mật khẩu -->
        <div class="col-lg-8 col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
                    <h5 class="mb-0 fw-bold text-dark">
                        <i class="fas fa-key text-warning me-2"></i>Thiết Lập Mật Khẩu Mới
                    </h5>
                    <span class="badge bg-light text-muted border"><i class="fas fa-lock me-1"></i>Mã hóa BCrypt</span>
                </div>
                <div class="card-body p-4">

                    <form action="@Url.Action("ChangePassword", "Account")" method="post" id="formChangePassword" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- Mật khẩu hiện tại -->
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-dark" for="currentPassword">
                                Mật khẩu hiện tại <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-lock"></i></span>
                                <input type="password" class="form-control border-start-0 border-end-0" id="currentPassword" name="currentPassword" required placeholder="Nhập mật khẩu hiện tại" autocomplete="current-password" />
                                <button class="btn btn-outline-secondary border-start-0 toggle-pass-btn" type="button" data-target="currentPassword" title="Ẩn/Hiện mật khẩu">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="form-text small text-muted">Nhập mật khẩu đang sử dụng để xác thực danh tính.</div>
                        </div>

                        <hr class="my-3 text-muted opacity-25" />

                        <!-- Mật khẩu mới -->
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-dark" for="newPassword">
                                Mật khẩu mới <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-key"></i></span>
                                <input type="password" class="form-control border-start-0 border-end-0" id="newPassword" name="newPassword" required minlength="6" placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)" autocomplete="new-password" />
                                <button class="btn btn-outline-secondary border-start-0 toggle-pass-btn" type="button" data-target="newPassword" title="Ẩn/Hiện mật khẩu">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>

                            <!-- Thanh đo độ mạnh mật khẩu -->
                            <div class="mt-2" id="strengthMeterWrapper" style="display: none;">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <small class="text-muted">Độ mạnh:</small>
                                    <small class="fw-bold" id="strengthText">-</small>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar transition-all" id="strengthBar" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Xác nhận mật khẩu mới -->
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-dark" for="confirmPassword">
                                Xác nhận mật khẩu mới <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-check-double"></i></span>
                                <input type="password" class="form-control border-start-0 border-end-0" id="confirmPassword" name="confirmPassword" required minlength="6" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                                <button class="btn btn-outline-secondary border-start-0 toggle-pass-btn" type="button" data-target="confirmPassword" title="Ẩn/Hiện mật khẩu">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <!-- Thông báo so khớp trực tiếp -->
                            <div id="matchFeedback" class="small mt-1" style="display: none;"></div>
                        </div>

                        <div class="d-flex gap-2 justify-content-end pt-2 border-top">
                            <a href="@homeUrl" class="btn btn-outline-secondary px-4 fw-semibold">
                                <i class="fas fa-arrow-left me-1"></i>Quay lại
                            </a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm" id="btnSubmit">
                                <i class="fas fa-save me-1"></i>Lưu Thay Đổi
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
    (function () {
        // 1. Chức năng Ẩn / Hiện mật khẩu khi bấm con mắt
        document.querySelectorAll('.toggle-pass-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var targetId = this.getAttribute('data-target');
                var input = document.getElementById(targetId);
                var icon = this.querySelector('i');
                if (!input) return;

                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                }
            });
        });

        // 2. Đo độ mạnh mật khẩu khi gõ
        var newPassInput = document.getElementById('newPassword');
        var strengthWrapper = document.getElementById('strengthMeterWrapper');
        var strengthBar = document.getElementById('strengthBar');
        var strengthText = document.getElementById('strengthText');

        function checkStrength(pass) {
            if (!pass || pass.length === 0) return 0;
            var score = 0;
            if (pass.length >= 6) score += 25;
            if (pass.length >= 8) score += 15;
            if (/[a-z]/.test(pass) && /[A-Z]/.test(pass)) score += 25;
            if (/\d/.test(pass)) score += 20;
            if (/[^a-zA-Z0-9]/.test(pass)) score += 15;
            return Math.min(score, 100);
        }

        if (newPassInput) {
            newPassInput.addEventListener('input', function () {
                var val = this.value;
                if (val.length > 0) {
                    strengthWrapper.style.display = 'block';
                    var score = checkStrength(val);
                    strengthBar.style.width = score + '%';

                    if (score < 40) {
                        strengthBar.className = 'progress-bar bg-danger';
                        strengthText.textContent = 'Yếu';
                        strengthText.className = 'fw-bold text-danger';
                    } else if (score < 70) {
                        strengthBar.className = 'progress-bar bg-warning';
                        strengthText.textContent = 'Trung bình';
                        strengthText.className = 'fw-bold text-warning';
                    } else if (score < 90) {
                        strengthBar.className = 'progress-bar bg-info';
                        strengthText.textContent = 'Khá mạnh';
                        strengthText.className = 'fw-bold text-info';
                    } else {
                        strengthBar.className = 'progress-bar bg-success';
                        strengthText.textContent = 'Rất mạnh';
                        strengthText.className = 'fw-bold text-success';
                    }
                } else {
                    strengthWrapper.style.display = 'none';
                }
                checkMatch();
            });
        }

        // 3. Kiểm tra so khớp 2 mật khẩu trực tiếp
        var confirmPassInput = document.getElementById('confirmPassword');
        var matchFeedback = document.getElementById('matchFeedback');

        function checkMatch() {
            if (!confirmPassInput || !matchFeedback) return;
            var newPass = newPassInput.value;
            var confirmPass = confirmPassInput.value;

            if (confirmPass.length === 0) {
                matchFeedback.style.display = 'none';
                return;
            }

            matchFeedback.style.display = 'block';
            if (newPass === confirmPass) {
                matchFeedback.className = 'small mt-1 text-success fw-semibold';
                matchFeedback.innerHTML = '<i class="fas fa-check-circle me-1"></i>Mật khẩu xác nhận khớp!';
            } else {
                matchFeedback.className = 'small mt-1 text-danger fw-semibold';
                matchFeedback.innerHTML = '<i class="fas fa-times-circle me-1"></i>Mật khẩu xác nhận không khớp.';
            }
        }

        if (confirmPassInput) {
            confirmPassInput.addEventListener('input', checkMatch);
        }

        // 4. Validate trước khi gửi form
        var form = document.getElementById('formChangePassword');
        if (form) {
            form.addEventListener('submit', function (e) {
                var cur = document.getElementById('currentPassword').value.trim();
                var n1 = newPassInput.value;
                var n2 = confirmPassInput.value;

                if (!cur) {
                    alert('Vui lòng nhập mật khẩu hiện tại!');
                    e.preventDefault();
                    return;
                }
                if (!n1 || n1.length < 6) {
                    alert('Mật khẩu mới phải có ít nhất 6 ký tự!');
                    e.preventDefault();
                    return;
                }
                if (n1 === cur) {
                    alert('Mật khẩu mới không được trùng với mật khẩu hiện tại!');
                    e.preventDefault();
                    return;
                }
                if (n1 !== n2) {
                    alert('Mật khẩu xác nhận không khớp! Vui lòng kiểm tra lại.');
                    e.preventDefault();
                    return;
                }
            });
        }
    })();
</script>
}