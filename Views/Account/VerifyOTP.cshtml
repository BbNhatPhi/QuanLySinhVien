@{
    ViewBag.Title = "Xác thực OTP";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Xác thực OTP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body { background: #f4f6f9; font-family: 'Be Vietnam Pro', sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .card { border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); width: 100%; max-width: 400px; border: none; }
        .card-header { background: #17a2b8; color: white; border-radius: 15px 15px 0 0 !important; text-align: center; padding: 25px; border-bottom: none; }
    </style>
</head>
<body>
    <div class="card">
        <div class="card-header">
            <h4><i class="fas fa-shield-alt"></i> Xác thực bảo mật</h4>
            <p class="mb-0 small">Mã OTP đã được gửi đến Email của bạn</p>
        </div>
        <div class="card-body p-4">
            <div class="alert alert-info small text-center mb-4">
                <i class="fas fa-info-circle"></i> Để mô phỏng, vui lòng mở thư mục <strong>App_Data</strong> trong Project và xem file <strong>EmailOTP.txt</strong> để lấy mã.
            </div>
            @if (TempData["ErrorMsg"] != null) {
                <div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMsg"]</div>
            }
            <form action="@Url.Action("VerifyOTP", "Account")" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label fw-bold text-center w-100">Nhập mã OTP (6 số)</label>
                    <input type="text" name="otp" class="form-control form-control-lg text-center fw-bold text-primary tracking-widest" maxlength="6" required autofocus />
                </div>
                <button type="submit" class="btn btn-info text-white w-100 btn-lg fw-bold mb-3"><i class="fas fa-check-circle"></i> Xác thực</button>
                <div class="text-center">
                    <a href="@Url.Action("Login", "Account")" class="text-decoration-none text-muted"><i class="fas fa-times"></i> Hủy giao dịch</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>