@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Quên mật khẩu - Hệ thống Đào tạo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body { background: #f4f6f9; font-family: 'Be Vietnam Pro', sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
        .card { border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); width: 100%; max-width: 400px; border: none; }
        .card-header { background: #004085; color: white; border-radius: 15px 15px 0 0 !important; text-align: center; padding: 25px; border-bottom: none; }
    </style>
</head>
<body>
    <div class="card">
        <div class="card-header">
            <h4><i class="fas fa-lock"></i> Quên mật khẩu</h4>
            <p class="mb-0 small">Nhập tên đăng nhập để nhận mã OTP</p>
        </div>
        <div class="card-body p-4">
            @if (TempData["ErrorMsg"] != null) {
                <div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i> @TempData["ErrorMsg"]</div>
            }
            <form action="@Url.Action("ForgotPassword", "Account")" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label fw-bold">Tên đăng nhập (Mã SV / GV)</label>
                    <input type="text" name="username" class="form-control form-control-lg" required autofocus />
                </div>
                <button type="submit" class="btn btn-primary w-100 btn-lg fw-bold mb-3"><i class="fas fa-paper-plane"></i> Gửi mã OTP</button>
                <div class="text-center">
                    <a href="@Url.Action("Login", "Account")" class="text-decoration-none"><i class="fas fa-arrow-left"></i> Quay lại đăng nhập</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>