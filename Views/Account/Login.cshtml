@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập - Hệ thống Quản lý Đào tạo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <!-- Nạp font 'Be Vietnam Pro' cho trang đăng nhập (trang này không dùng _Layout nên phải nạp riêng) -->
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" />
</head>
<body class="login-body">
    <div class="login-card">
        <div class="login-head">
            <div class="login-logo"><i class="fas fa-university"></i></div>
            <h4>ĐĂNG NHẬP HỆ THỐNG</h4>
            <p>Đại học Nguyễn Tất Thành - Cổng thông tin đào tạo</p>
        </div>
        <div class="login-body-inner">
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                    <i class="fas fa-circle-exclamation"></i> @ViewBag.Error
                </div>
            }

            <form action="@Url.Action("Login", "Account")" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">Tên đăng nhập</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        <input type="text" name="username" class="form-control" required placeholder="Nhập tên tài khoản" autofocus />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input type="password" name="password" class="form-control" required placeholder="Nhập mật khẩu" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2 mt-2 fs-6">
                    <i class="fas fa-right-to-bracket me-1"></i> Đăng nhập
                </button>
            </form>

            <p class="text-center text-muted small mt-4 mb-0">
                &copy; @DateTime.Now.Year Đại học Nguyễn Tất Thành
            </p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>