@{
    ViewBag.Title = "Trang chủ";
}

<div class="page-head">
    <div>
        <h1><i class="fas fa-house-chimney text-primary me-2"></i>Chào mừng đến với Cổng thông tin Đào tạo</h1>
        <p class="lead">Hệ thống quản lý sinh viên, giảng viên, học phần và điểm số của Đại học Nguyễn Tất Thành.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <i class="fas fa-user-graduate text-primary fs-1 mb-3"></i>
                <h5 class="fw-bold">Sinh viên</h5>
                <p class="text-muted mb-0">Tra cứu thời khóa biểu, điểm số, học phí và đăng ký học phần trực tuyến.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <i class="fas fa-user-tie text-success fs-1 mb-3"></i>
                <h5 class="fw-bold">Giảng viên</h5>
                <p class="text-muted mb-0">Xem lịch giảng dạy, điểm danh, nhập điểm và in bảng điểm.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <i class="fas fa-building-columns text-warning fs-1 mb-3"></i>
                <h5 class="fw-bold">Phòng Đào tạo</h5>
                <p class="text-muted mb-0">Quản lý sinh viên, giảng viên, môn học, lịch thi và thời khóa biểu.</p>
            </div>
        </div>
    </div>
</div>